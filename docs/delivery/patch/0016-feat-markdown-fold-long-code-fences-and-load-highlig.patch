diff --git a/scripts/run-streaming-unfolded.mjs b/scripts/run-streaming-unfolded.mjs
new file mode 100644
index 00000000..2546de2a
--- /dev/null
+++ b/scripts/run-streaming-unfolded.mjs
@@ -0,0 +1,104 @@
+/**
+ * Run the streaming regression without shell fd syntax or GNU timeout/nice.
+ *
+ *   node scripts/run-streaming-unfolded.mjs
+ *
+ * Child fd 1 is drained and discarded: the renderer may write terminal reset
+ * bytes there during teardown. The regression's independent fd 3 is forwarded
+ * to our stdout, and child stderr is forwarded to stderr. The child has no real
+ * HOME/DSH/XDG settings or credentials in its environment. Its own script
+ * creates and checks its private temporary directory before application imports.
+ *
+ * The wrapper uses Node rather than shell fd syntax, but the extra fd and
+ * terminal behavior have not yet been verified on Windows.
+ * A normal child exit is propagated unchanged; a timeout is reported as 124.
+ */
+import { spawn } from 'node:child_process'
+import { constants as osConstants, tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { randomUUID } from 'node:crypto'
+import { fileURLToPath } from 'node:url'
+
+const root = dirname(dirname(fileURLToPath(import.meta.url)))
+const test = join(root, 'scripts', 'verify-streaming-unfolded.tsx')
+// Deliberately nonexistent: the child creates its own checked temp root.
+// This avoids exposing the caller's real home even to the tsx loader.
+const unavailableHome = join(tmpdir(), `dsh-stream-loader-nohome-${randomUUID()}`)
+const env = {
+  PATH: process.env.PATH ?? '',
+  NODE_ENV: 'production',
+  HOME: unavailableHome,
+  USERPROFILE: unavailableHome,
+  TMPDIR: tmpdir(),
+  TMP: tmpdir(),
+  TEMP: tmpdir(),
+  XDG_CONFIG_HOME: join(unavailableHome, 'config'),
+  XDG_CACHE_HOME: join(unavailableHome, 'cache'),
+  XDG_DATA_HOME: join(unavailableHome, 'data'),
+  XDG_STATE_HOME: join(unavailableHome, 'state'),
+  DSH_HOME: join(unavailableHome, 'dsh'),
+  TSX_DISABLE_CACHE: '1',
+}
+// Windows process creation and Node tooling can need these OS paths. None is a
+// user session or credential; no other inherited variables reach the loader.
+for (const key of ['SystemRoot', 'WINDIR', 'COMSPEC', 'PATHEXT']) {
+  if (process.env[key] !== undefined) env[key] = process.env[key]
+}
+
+const child = spawn(process.execPath, ['--import', 'tsx/esm', test], {
+  cwd: root,
+  env,
+  stdio: ['ignore', 'pipe', 'pipe', 'pipe'],
+  windowsHide: true,
+})
+child.stdout.resume()
+child.stderr.pipe(process.stderr, { end: false })
+child.stdio[3].pipe(process.stdout, { end: false })
+
+const timeoutMs = 90_000
+let timedOut = false
+let externalSignal = null
+let forceTimer
+let spawnError = null
+function terminate() {
+  if (child.exitCode !== null || child.signalCode !== null) return
+  child.kill('SIGTERM')
+  if (!forceTimer) {
+    forceTimer = setTimeout(() => {
+      if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL')
+    }, 5_000)
+  }
+}
+const timeout = setTimeout(() => {
+  timedOut = true
+  process.stderr.write(`streaming-unfolded: timed out after ${timeoutMs}ms; terminating child\n`)
+  terminate()
+}, timeoutMs)
+const onSignal = signal => {
+  externalSignal ??= signal
+  terminate()
+}
+const onInt = () => onSignal('SIGINT')
+const onTerm = () => onSignal('SIGTERM')
+process.on('SIGINT', onInt)
+process.on('SIGTERM', onTerm)
+child.on('error', error => { spawnError = error })
+// close, not exit: the fd 3 reporter has also drained before returning.
+child.on('close', (code, signal) => {
+  clearTimeout(timeout)
+  if (forceTimer) clearTimeout(forceTimer)
+  process.off('SIGINT', onInt)
+  process.off('SIGTERM', onTerm)
+  if (spawnError) {
+    process.stderr.write(`streaming-unfolded: child spawn error: ${spawnError.message}\n`)
+    process.exitCode = 1
+  } else if (timedOut) {
+    process.exitCode = 124
+  } else if (externalSignal) {
+    process.exitCode = 128 + (osConstants.signals[externalSignal] ?? 1)
+  } else if (code !== null) {
+    process.exitCode = code
+  } else {
+    process.exitCode = 128 + (osConstants.signals[signal] ?? 1)
+  }
+})
diff --git a/scripts/verify-code-fence-chat.tsx b/scripts/verify-code-fence-chat.tsx
new file mode 100644
index 00000000..f3e6a92d
--- /dev/null
+++ b/scripts/verify-code-fence-chat.tsx
@@ -0,0 +1,201 @@
+/** Real Chat + headless xterm SGR fence disclosure regression. No real backend.
+ * Run: node --import tsx/esm scripts/verify-code-fence-chat.tsx
+ */
+import assert from 'node:assert/strict'
+import { closeSync, mkdtempSync, openSync, realpathSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { basename, dirname, join } from 'node:path'
+import { PassThrough, Writable } from 'node:stream'
+
+// Never inherit harness trace/session paths or a temporary root pointing at
+// user data. Every DSH/XDG path below belongs to this synthetic fixture.
+for (const key of Object.keys(process.env)) if (key.startsWith('DSH_') || key.startsWith('XDG_')) delete process.env[key]
+delete process.env.TMPDIR
+delete process.env.TMP
+delete process.env.TEMP
+const tempRoot = realpathSync(tmpdir())
+const home = realpathSync(mkdtempSync(join(tempRoot, 'code-fence-chat-')))
+let cleaned = false
+const cleanupHome = (): void => {
+  if (cleaned) return
+  // Re-resolve immediately before deletion, and reject any replaced path.
+  const actual = realpathSync(home)
+  assert.equal(actual, home, 'refuse to clean a replaced fixture path')
+  assert.equal(dirname(actual), tempRoot, 'refuse to clean outside the temporary root')
+  assert.ok(basename(actual).startsWith('code-fence-chat-'), 'refuse to clean a non-fixture directory')
+  rmSync(actual, { recursive: true, force: true })
+  cleaned = true
+}
+// Covers import/setup failures too; the normal finally cleans up first.
+process.once('exit', cleanupHome)
+process.env.HOME = home
+process.env.USERPROFILE = home
+process.env.DSH_HOME = join(home, '.dsh')
+process.env.XDG_CONFIG_HOME = join(home, '.config')
+process.env.XDG_CACHE_HOME = join(home, '.cache')
+process.env.XDG_DATA_HOME = join(home, '.local', 'share')
+process.env.XDG_STATE_HOME = join(home, '.local', 'state')
+process.env.DSH_TUI_LANG = 'en'
+process.env.FORCE_COLOR = '3'
+const [React, { Terminal }, { render, AlternateScreen }, { Chat }, { QuestionStore }, { LOCAL_COMMANDS }, { settled, sleep }, { default: inkInstances }] = await Promise.all([
+  import('react'), import('@xterm/headless'), import('../src/ui.js'),
+  import('../src/screens/Chat.js'), import('../src/dsh-adapter/questions.js'),
+  import('../src/commands.js'), import('./lib/term-test.mjs'), import('../src/ink/instances.js'),
+])
+const COLS = 100, ROWS = 45
+const term = new Terminal({ cols: COLS, rows: ROWS, scrollback: 0, allowProposedApi: true })
+const ttyFd = openSync(join(home, 'tty-output'), 'w')
+let pendingWrites = 0
+let parsedWrites = 0
+let frames = 0
+let requiredFrame = -1
+class Stdout extends Writable {
+  columns = COLS; rows = ROWS; isTTY = true; fd = ttyFd
+  _write(chunk: unknown, _encoding: BufferEncoding, done: () => void) {
+    pendingWrites++
+    term.write(String(chunk), () => { pendingWrites--; parsedWrites++; done() })
+  }
+}
+class Stdin extends PassThrough {
+  isTTY = true
+  setRawMode() { return this }
+  ref() { return this }
+  unref() { return this }
+}
+const stdout = new Stdout(), stdin = new Stdin()
+const stderr = Object.assign(new Writable({ write(_chunk, _encoding, done) { done() } }), { isTTY: true })
+const body = ['INTRO', '```js', 'BLOCK_A_HEAD', 'BLOCK_A_BODY', '```', '~~~mermaid', 'graph LR', 'MERM_START-->MERM_END', '~~~'].join('\n')
+const listeners = new Set<() => void>()
+const channel = {
+  version: 0, rows: [{ id: 1, kind: 'assistant', text: body, streaming: false }],
+  agentId: 'agent-a', sessionId: 'session-a', whaleIdle: false,
+  status: 'idle', sessionTitle: 'fixture', model: 'model', provider: 'fixture',
+  tokens: { input: 0, output: 0 }, cwd: home, displayCwd: home, gitBranch: '',
+  working: false, spinnerMode: 'requesting', mode: { plan: false }, responseChars: 0,
+  activeToolCount: 0, turnStart: 0, lastUserText: '', pending: [],
+  commandList: LOCAL_COMMANDS, commandCompletions: () => [], notifications: [],
+  contextSegments: { system: 0, prompt: 0, assistant: 0, thinking: 0, tools: 0 },
+  subscribe(fn: () => void) { listeners.add(fn); return () => listeners.delete(fn) },
+  submit() {}, steer() {}, cancel() {}, clear() { this.rows = []; this.emit() }, notify() {},
+  listModels: async () => [], listSessions: () => [], setResumeTarget() {},
+  emit() { requiredFrame = frames; this.version++; for (const fn of listeners) fn() },
+}
+const lines = () => Array.from({ length: ROWS }, (_, y) => term.buffer.active.getLine(term.buffer.active.baseY + y)?.translateToString(true) ?? '')
+const has = (s: string) => lines().some(line => line.includes(s))
+const diagnostics = () => JSON.stringify({ frames, requiredFrame, pendingWrites, parsedWrites, queuedBytes: stdout.writableLength })
+const writeInput = (input: string): void => { requiredFrame = frames; stdin.write(input) }
+const drain = async (): Promise<void> => {
+  // The sentinel queues after prior writes; another frame may be queued
+  // during parsing, so repeat until the writable and xterm are both idle.
+  for (let attempt = 0; attempt < 20; attempt++) {
+    await new Promise<void>((resolve, reject) => stdout.write('', error => error ? reject(error) : resolve()))
+    if (pendingWrites === 0 && stdout.writableLength === 0) return
+  }
+  assert.fail(`xterm output did not drain: ${diagnostics()}`)
+}
+const waitScreen = async (name: string, predicate: () => boolean): Promise<void> => {
+  assert.ok(await settled(() => frames > requiredFrame && pendingWrites === 0 && stdout.writableLength === 0 && predicate(), { timeoutMs: 15000 }), `${name}\n${diagnostics()}\n${lines().join('\n')}`)
+  await drain()
+  assert.ok(predicate(), `${name} after xterm drain\n${diagnostics()}\n${lines().join('\n')}`)
+}
+const click = async (s: string) => {
+  await waitScreen(`missing click target ${s}`, () => has(s))
+  const y = lines().findIndex(line => line.includes(s))
+  const x = lines()[y]!.indexOf(s) + 1
+  writeInput(`\x1b[<0;${x};${y + 1}M\x1b[<0;${x};${y + 1}m`)
+}
+const check = async (name: string, predicate: () => boolean) => {
+  await waitScreen(name, predicate)
+  console.log(`PASS: ${name}`)
+}
+let app: Awaited<ReturnType<typeof render>> | undefined
+try {
+  app = await render(<AlternateScreen><Chat channel={channel as never} questionStore={new QuestionStore()} fullscreen trajectorySeen /></AlternateScreen>, {
+    stdout: stdout as never, stdin: stdin as never, stderr: stderr as never, patchConsole: false, exitOnCtrlC: false,
+    onFrame: () => { frames++ },
+  })
+  await check('ordinary and Mermaid fences start folded', () => has('BLOCK_A_HEAD') && has('⌁ mermaid') && !has('BLOCK_A_BODY') && !has('MERM_END'))
+  await drain()
+  const dragRow = lines().findIndex(line => line.includes('BLOCK_A_HEAD')) + 1
+  const dragCol = lines()[dragRow - 1]!.indexOf('BLOCK_A_HEAD') + 1
+  writeInput(`\x1b[<0;${dragCol};${dragRow}M\x1b[<32;${dragCol + 5};${dragRow}M\x1b[<0;${dragCol + 5};${dragRow}m`)
+  await waitScreen('selection drag reaches a fresh parsed frame', () => true)
+  await sleep(250) // 固定窗:探针 selection drag must not dispatch a delayed click
+  await drain()
+  assert.ok(!has('BLOCK_A_BODY') && has('⌁ mermaid'), 'selection drag must not open a fence')
+  console.log('PASS: selection drag does not toggle a fence')
+  writeInput('\x1b') // clear selection before the click
+  await sleep(600) // 固定窗:墙钟 mouse double-click recognition window
+  await click('BLOCK_A_HEAD')
+  await check('open A without opening Mermaid', () => has('BLOCK_A_BODY') && has('⌁ mermaid') && !has('MERM_END'))
+  writeInput('\x0c')
+  // Chat's Ctrl+L lookup uses process.stdout, not the isolated fake stream.
+  // Force its own Ink instance to redraw so this assertion observes a real
+  // new frame rather than claiming the unchanged old buffer is a redraw.
+  const ink = inkInstances.get(stdout as never)
+  assert.ok(ink, 'fake stdout must own an Ink instance')
+  ink.forceRedraw()
+  await check('redraw preserves individual state', () => has('BLOCK_A_BODY') && has('⌁ mermaid'))
+  writeInput('\x0f')
+  await check('Ctrl+O temporarily opens both from A-open B-closed', () => has('BLOCK_A_BODY') && !has('⌁ mermaid') && (has('MERM_START') || has('graph LR')))
+  await sleep(600) // 固定窗:墙钟 mouse double-click recognition window
+  await drain()
+  await click(has('MERM_START') ? 'MERM_START' : 'graph LR')
+  await check('global mode can close B without changing A', () => has('BLOCK_A_BODY') && has('⌁ mermaid'))
+  writeInput('\x0f')
+  await check('leaving global mode restores A-open B-closed', () => has('BLOCK_A_BODY') && has('⌁ mermaid'))
+  // Consecutive clicks at a nearby location are interpreted as double-clicks.
+  await sleep(600) // 固定窗:墙钟 mouse double-click recognition window
+  await click('⌁ mermaid')
+  await check('Mermaid expands independently', () => has('BLOCK_A_BODY') && !has('⌁ mermaid') && (has('MERM_START') || has('graph LR')))
+  await sleep(600) // 固定窗:墙钟 mouse double-click recognition window
+  await click('BLOCK_A_BODY')
+  await check('closing A keeps Mermaid expanded', () => !has('BLOCK_A_BODY') && has('BLOCK_A_HEAD') && !has('⌁ mermaid'))
+  writeInput('\x0f')
+  await check('Ctrl+O expands both', () => has('BLOCK_A_BODY') && !has('⌁ mermaid'))
+  writeInput('\x0f')
+  await check('Ctrl+O restores individual states', () => !has('BLOCK_A_BODY') && !has('⌁ mermaid'))
+  channel.rows = []; channel.emit()
+  await check('row is actually unmounted', () => !has('BLOCK_A_HEAD'))
+  channel.rows = [{ id: 1, kind: 'assistant', text: body, streaming: false }]; channel.emit()
+  await check('remount preserves the open Mermaid path', () => has('BLOCK_A_HEAD') && !has('BLOCK_A_BODY') && !has('⌁ mermaid'))
+  writeInput('/clear')
+  await check('clear command reaches composer', () => has('/clear'))
+  writeInput('\r')
+  await check('/clear removes old rows', () => !has('BLOCK_A_HEAD'))
+  channel.rows = [{ id: 1, kind: 'assistant', text: body, streaming: false }]; channel.emit()
+  await check('/clear prevents row-id reuse from inheriting disclosure', () => has('⌁ mermaid') && !has('BLOCK_A_BODY'))
+  await sleep(600) // 固定窗:墙钟 mouse double-click recognition window
+  await click('⌁ mermaid')
+  await check('open a fence before session switch', () => !has('⌁ mermaid') && (has('MERM_START') || has('graph LR')))
+  channel.agentId = 'agent-b'; channel.sessionId = 'session-b'; channel.emit()
+  await check('new session with reused row id has no old disclosure', () => has('⌁ mermaid') && !has('BLOCK_A_BODY'))
+  channel.rows = [{ id: 1, kind: 'assistant', text: body, streaming: true }]; channel.emit()
+  await check('streaming fences are not folded', () => has('BLOCK_A_BODY') && !has('⌁ mermaid'))
+  const longCode = `LONG_CODE_HEAD${'x'.repeat(1200)}LONG_CODE_TAIL`
+  channel.rows = [{ id: 1, kind: 'assistant', text: `PLAIN_PROSE\n\n\`\`\`text\n${longCode}\n\`\`\`\n\n~~~py\nOTHER_CODE_BODY\n~~~`, streaming: false }]; channel.emit()
+  await check('long fence alone does not fold surrounding prose', () => has('PLAIN_PROSE') && has('⌁ text') && has('⌁ py'))
+  await sleep(600) // 固定窗:墙钟 mouse double-click recognition window
+  await click('PLAIN_PROSE')
+  await sleep(250) // 固定窗:探针 prose click must not unfold either fence
+  await drain()
+  assert.ok(has('⌁ text') && has('⌁ py') && !has('LONG_CODE_TAIL'), `ordinary prose click must not toggle fences\n${lines().join('\n')}`)
+  console.log('PASS: ordinary prose click does not unfold long fence or sibling')
+  const longProse = `LONG_PROSE_HEAD${'p'.repeat(1200)}LONG_PROSE_TAIL`
+  channel.rows = [{ id: 1, kind: 'assistant', text: `${longProse}\n\n\`\`\`text\n${longCode}\n\`\`\``, streaming: false }]; channel.emit()
+  await check('long prose retains its independent fold', () => has('chars folded') && has('⌁ text') && !has('LONG_PROSE_TAIL'))
+  await sleep(600) // 固定窗:墙钟 mouse double-click recognition window
+  await click('⌁ text')
+  await check('long code opens to its real tail without opening parent prose', () => has('LONG_CODE_TAIL') && has('chars folded') && !has('LONG_PROSE_TAIL'))
+  channel.rows = [{ id: 1, kind: 'assistant', text: `${'s'.repeat(1200)}STREAM_LONG_TAIL`, streaming: true }]; channel.emit()
+  await check('streaming long line is not clipped', () => has('STREAM_LONG_TAIL') && !has('chars folded'))
+} finally {
+  try {
+    if (app) await app.unmount()
+    await drain()
+  } finally {
+    term.dispose()
+    closeSync(ttyFd)
+    cleanupHome()
+  }
+}
diff --git a/scripts/verify-code-fence-lru.tsx b/scripts/verify-code-fence-lru.tsx
new file mode 100644
index 00000000..334522e9
--- /dev/null
+++ b/scripts/verify-code-fence-lru.tsx
@@ -0,0 +1,248 @@
+/**
+ * Real channel history LRU + Chat/xterm fence-state regression. The target is
+ * opened by SGR mouse; unrelated chunks are materialized via channel.revealRow
+ * solely to force eviction. Synthetic records, no real sessions or credentials.
+ * Run: node --import tsx/esm scripts/verify-code-fence-lru.tsx
+ */
+import assert from 'node:assert/strict'
+import { closeSync, mkdtempSync, openSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, resolve } from 'node:path'
+import { PassThrough, Writable } from 'node:stream'
+
+// Ignore inherited harness paths and temp overrides: the fixture owns every
+// DSH/XDG destination and never writes a real terminal fd.
+for (const key of Object.keys(process.env)) if (key.startsWith('DSH_')) delete process.env[key]
+delete process.env.TMPDIR
+delete process.env.TMP
+delete process.env.TEMP
+const prefix = join(tmpdir(), 'code-fence-lru-')
+const home = mkdtempSync(prefix)
+process.env.HOME = home
+process.env.USERPROFILE = home
+process.env.DSH_HOME = join(home, '.dsh')
+process.env.XDG_CONFIG_HOME = join(home, '.config')
+process.env.XDG_CACHE_HOME = join(home, '.cache')
+process.env.XDG_DATA_HOME = join(home, '.local', 'share')
+process.env.XDG_STATE_HOME = join(home, '.local', 'state')
+process.env.DSH_TUI_LANG = 'en'
+process.env.FORCE_COLOR = '3'
+const [React, { Terminal }, { render, AlternateScreen }, { Chat }, { QuestionStore }, { createChannel }, { mountChannelUi }, { registerTuiChannel }, { settled, sleep }, { default: inkInstances }] = await Promise.all([
+  import('react'), import('@xterm/headless'), import('../src/ui.js'), import('../src/screens/Chat.js'),
+  import('../src/dsh-adapter/questions.js'), import('../src/dsh-adapter/channel.js'),
+  import('../src/dsh-adapter/channel-ui.js'), import('../src/adapter/channel/host-registry.js'),
+  import('./lib/term-test.mjs'), import('../src/ink/instances.js'),
+])
+type RawEvent = { type: string; seq: number; time: number; data: Record<string, unknown> }
+const events: RawEvent[] = []
+const append = (type: string, data: Record<string, unknown>) => {
+  const seq = events.length + 1
+  events.push({ type, seq, time: seq, data })
+}
+for (let n = 1; n <= 8; n++) {
+  append('user/message', { id: `user-${n}`, source: { kind: 'user' }, content: [{ type: 'text', text: `LRU-PROMPT-${n}` }] })
+  append('tool/call', { turn: n, step: 1, callId: `weight-${n}`, name: 'ask_user_question', arguments: JSON.stringify({ unused: 'x'.repeat(1_010_000) }) })
+  const text = `answer ${n}\n\n\`\`\`js\nA_HEAD_${n}\nA_BODY_${n}\n\`\`\`\n\n~~~py\nB_HEAD_${n}\nB_BODY_${n}\n~~~`
+  append('assistant/message', { turn: n, step: 1, message: { role: 'assistant', content: [{ type: 'text', text }] } })
+}
+const cleanups: Array<() => void> = []
+const agent = { id: 'lru-test', status: 'idle', session: { id: 'lru-session', seq: events.length, events, header: { cwd: home } }, ctx: { on: () => () => undefined }, followup() {}, steer() {}, cancel() {}, inbox: { remove: () => true } }
+const services: Record<string, unknown> = {
+  settings: { describe: () => [{ ns: 'llm-pi-ai', revision: 1, user: {}, value: {} }, { ns: 'dsh-tui', revision: 1, user: {}, value: { recapOnOpen: false } }], get: () => ({}), mutate: async () => undefined },
+  credentials: { resolve: async () => undefined, set: async () => undefined, unset: async () => undefined },
+  llm: { listConfigurableProviders: () => [], discoverModels: async () => [] },
+  agents: {},
+}
+const ctx = { on: () => () => undefined, effect(setup: () => () => void) { cleanups.push(setup()) }, get: (name: string) => services[name], logger: { warn() {} } }
+const raw = createChannel(ctx as never, agent as never, { model: 'model', provider: 'provider', cwd: home, activity: false, whale: false, whaleIdle: false, minimalUi: true, smoothStreaming: false })
+const unregister = registerTuiChannel(ctx, raw)
+const mount = mountChannelUi(ctx, raw, undefined, 'new')
+const summaries = () => mount.channel.rows.filter(row => row.collapsed === true)
+const targetSummary = summaries().find(row => row.collapsedTurns?.some(turn => turn.text === 'LRU-PROMPT-2'))
+const target = targetSummary?.collapsedTurns?.find(turn => turn.text === 'LRU-PROMPT-2')
+assert.ok(targetSummary && target, 'must seed seven independently evictable old chunks')
+assert.ok(summaries().length >= 7, 'each heavy round must occupy its own chunk')
+const COLS = 100, ROWS = 45
+const term = new Terminal({ cols: COLS, rows: ROWS, scrollback: 0, allowProposedApi: true })
+const ttyFd = openSync(join(home, 'tty-output'), 'w')
+let pendingWrites = 0
+let parsedWrites = 0
+let frames = 0
+class Stdout extends Writable {
+  columns = COLS; rows = ROWS; isTTY = true; fd = ttyFd
+  _write(chunk: unknown, _encoding: BufferEncoding, done: () => void) {
+    pendingWrites++
+    term.write(String(chunk), () => { pendingWrites--; parsedWrites++; done() })
+  }
+}
+class Stdin extends PassThrough {
+  isTTY = true
+  setRawMode() { return this }
+  ref() { return this }
+  unref() { return this }
+}
+const stdout = new Stdout(), stdin = new Stdin()
+const stderr = Object.assign(new Writable({ write(_chunk, _encoding, done) { done() } }), { isTTY: true })
+const lines = () => Array.from({ length: ROWS }, (_, y) => term.buffer.active.getLine(term.buffer.active.baseY + y)?.translateToString(true) ?? '')
+const has = (s: string) => lines().some(line => line.includes(s))
+type ProbeNode = {
+  nodeName?: string
+  nodeValue?: string
+  childNodes?: ProbeNode[]
+  scrollTop?: number
+  scrollHeight?: number
+  scrollViewportHeight?: number
+  scrollViewportTop?: number
+  stickyScroll?: boolean
+  yogaNode?: { getComputedTop(): number; getComputedHeight(): number }
+}
+const root = (): ProbeNode | undefined => (inkInstances.get(stdout as never) as unknown as { rootNode?: ProbeNode } | undefined)?.rootNode
+const walk = (node: ProbeNode | undefined, visit: (node: ProbeNode) => void): void => {
+  if (!node) return
+  visit(node)
+  for (const child of node.childNodes ?? []) walk(child, visit)
+}
+const textNode = (text: string): ProbeNode | undefined => {
+  let result: ProbeNode | undefined
+  walk(root(), node => { if (node.nodeValue?.includes(text)) result = node })
+  return result
+}
+const pathToText = (text: string): ProbeNode[] | undefined => {
+  const search = (node: ProbeNode | undefined, parents: ProbeNode[]): ProbeNode[] | undefined => {
+    if (!node) return undefined
+    const path = [...parents, node]
+    if (node.nodeValue?.includes(text)) return path
+    for (const child of node.childNodes ?? []) {
+      const found = search(child, path)
+      if (found) return found
+    }
+    return undefined
+  }
+  return search(root(), [])
+}
+// The LCA of the two code texts is Markdown's column; the four containing
+// boxes are Markdown's host, the bullet row, AssistantTextMessage, then the
+// settled TranscriptRow Box whose ref is registered with MessageList.
+const assistantRowRef = (): ProbeNode => {
+  const a = pathToText('A_BODY_2'), b = pathToText('B_HEAD_2')
+  assert.ok(a && b, 'both blocks must have mounted DOM nodes')
+  let common = 0
+  while (common < a.length && common < b.length && a[common] === b[common]) common++
+  const row = a[common - 1 - 4]
+  assert.ok(row?.nodeName === 'ink-box', `expected TranscriptRow Box at the shared Markdown path: ${a.map(node => node.nodeName).join(' > ')}`)
+  return row
+}
+const containsNode = (target: ProbeNode): boolean => {
+  let found = false
+  walk(root(), node => { if (node === target) found = true })
+  return found
+}
+const geometry = () => {
+  let scroll: ProbeNode | undefined
+  walk(root(), node => { if (node.scrollViewportHeight !== undefined) scroll = node })
+  return scroll && { top: scroll.scrollTop, height: scroll.scrollHeight, viewport: scroll.scrollViewportHeight, viewportTop: scroll.scrollViewportTop, sticky: scroll.stickyScroll }
+}
+const diagnostic = () => JSON.stringify({ frames, parsedWrites, pendingWrites, queuedBytes: stdout.writableLength, geometry: geometry(), mountedBody: textNode('A_BODY_2') !== undefined, summaries: summaries().map(row => row.id) })
+// A sentinel queues behind every earlier stdout write. The write callback
+// fires only after xterm's own parse callback, not merely after enqueueing.
+const drain = async (): Promise<void> => {
+  // Rendering may queue another write while the sentinel is being parsed.
+  // Drain those too; otherwise the screen can still be partway through a
+  // subsequent frame when the sentinel callback resolves.
+  for (let attempt = 0; attempt < 20; attempt++) {
+    await new Promise<void>((resolve, reject) => stdout.write('', error => error ? reject(error) : resolve()))
+    if (pendingWrites === 0 && stdout.writableLength === 0) return
+  }
+  assert.fail(`xterm output did not drain: ${diagnostic()}`)
+}
+const wait = async (name: string, predicate: () => boolean) => {
+  assert.ok(await settled(() => pendingWrites === 0 && stdout.writableLength === 0 && predicate(), { timeoutMs: 15000 }), `${name}\n${diagnostic()}\n${lines().join('\n')}`)
+  await drain()
+  assert.ok(predicate(), `${name} after xterm drain\n${diagnostic()}\n${lines().join('\n')}`)
+  console.log(`PASS: ${name}`)
+}
+const click = async (text: string) => {
+  await wait(`mouse target ${text}`, () => has(text))
+  const y = lines().findIndex(line => line.includes(text))
+  const x = lines()[y]!.indexOf(text) + 1
+  stdin.write(`\x1b[<0;${x};${y + 1}M\x1b[<0;${x};${y + 1}m`)
+}
+// Home edits the prompt; fullscreen Chat pages the transcript with PgUp.
+// Wait for an actual new frame and viewport motion after every page, rather
+// than guessing when scrolling/virtualization has converged.
+const pageUpTo = async (present: () => boolean): Promise<void> => {
+  for (let attempts = 0; attempts < 8 && !present(); attempts++) {
+    const before = geometry()?.top
+    assert.notEqual(before, undefined, `missing scroll geometry: ${diagnostic()}`)
+    assert.ok(before! > 0, `target absent at transcript top\n${diagnostic()}\n${lines().join('\n')}`)
+    const beforeFrame = frames
+    stdin.write('\x1b[5~')
+    await wait('PgUp paints actual transcript movement', () => frames > beforeFrame && ((geometry()?.top ?? before!) < before! || present()))
+  }
+  assert.ok(present(), `target must be reachable after bounded PgUp navigation\n${diagnostic()}\n${lines().join('\n')}`)
+}
+let app: Awaited<ReturnType<typeof render>> | undefined
+let rerenderCommitFrame: number | undefined
+const questionStore = new QuestionStore()
+function RerenderProbe({ generation }: { generation: number }): React.ReactNode {
+  React.useLayoutEffect(() => {
+    if (generation === 1) rerenderCommitFrame = frames
+  }, [generation])
+  return <AlternateScreen><Chat channel={mount.channel as never} questionStore={questionStore} fullscreen trajectorySeen /></AlternateScreen>
+}
+const tree = (generation = 0) => <RerenderProbe generation={generation} />
+try {
+  // Direct channel projection is used for setup, not to toggle disclosure.
+  mount.channel.revealRow(target.id)
+  const assistant = mount.channel.rows.find(row => row.kind === 'assistant' && row.text.includes('A_HEAD_2'))
+  assert.ok(assistant, 'target assistant must materialize')
+  app = await render(tree(), {
+    stdout: stdout as never, stdin: stdin as never, stderr: stderr as never, patchConsole: false, exitOnCtrlC: false,
+    onFrame: () => { frames++ },
+  })
+  await wait('initial Chat frame is ready', () => has('LRU-PROMPT-8'))
+  await pageUpTo(() => has('A_HEAD_2') && has('B_HEAD_2'))
+  await wait('target shows two independently folded blocks', () => has('A_HEAD_2') && has('B_HEAD_2') && !has('A_BODY_2') && !has('B_BODY_2'))
+  await click('A_HEAD_2')
+  await wait('SGR opens A only', () => has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'))
+  const oldRowRef = assistantRowRef()
+  assert.ok(containsNode(oldRowRef), 'the original assistant row ref must actually be mounted')
+  const beforeEvictionFrame = frames
+  for (const summary of summaries().filter(row => row.id !== targetSummary.id)) mount.channel.revealRow(summary.id)
+  assert.ok(summaries().some(row => row.id === targetSummary.id), 'target chunk must actually be evicted by the LRU')
+  console.log('PASS: real channel LRU evicted target chunk')
+  await wait('eviction paints a new frame and unmounts the original row ref', () => frames > beforeEvictionFrame && !containsNode(oldRowRef) && !has('A_BODY_2'))
+  console.log(`EVICTED ${diagnostic()}`)
+  const beforeRematerializeFrame = frames
+  mount.channel.revealRow(target.id)
+  assert.ok(mount.channel.rows.some(row => row.id === assistant.id && row.kind === 'assistant'), 'rematerialized row must keep its id')
+  console.log('PASS: rematerialized row retains its id')
+  await wait('rematerialization schedules a fresh frame', () => frames > beforeRematerializeFrame)
+  await pageUpTo(() => (has('A_BODY_2') || has('A_HEAD_2')) && has('B_HEAD_2'))
+  await wait('real LRU rematerialization keeps A open and B closed', () => textNode('A_BODY_2') !== undefined && has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'))
+  assert.notEqual(assistantRowRef(), oldRowRef, 'rematerialization must mount a new assistant row ref')
+  console.log(`RESTORED ${diagnostic()}`)
+  app.rerender(tree(1))
+  await wait('independent React rerender commits and produces a later frame', () => rerenderCommitFrame !== undefined && frames > rerenderCommitFrame)
+  assert.ok(has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'), `rerender must preserve A open / B closed\n${diagnostic()}\n${lines().join('\n')}`)
+  const ink = inkInstances.get(stdout as never)
+  assert.ok(ink, 'the fake stdout must own an Ink instance')
+  const beforeRedrawFrame = frames
+  ink.forceRedraw()
+  await wait('independent full redraw produces a new parsed frame', () => frames > beforeRedrawFrame)
+  assert.ok(has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'), `full redraw must preserve A open / B closed\n${diagnostic()}\n${lines().join('\n')}`)
+  console.log(`REDRAWN ${diagnostic()}`)
+  await sleep(200) // 固定窗:探针 no delayed layout update may undo the fresh redraw
+  await drain()
+  assert.ok(has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'), `restored state must remain stable after redraw\n${diagnostic()}\n${lines().join('\n')}`)
+  console.log(`PASS: restored state stays stable after redraw ${diagnostic()}`)
+} finally {
+  if (app) await app.unmount()
+  await drain()
+  mount.dispose(); unregister(); raw.releaseContributions()
+  for (const cleanup of cleanups.reverse()) cleanup()
+  term.dispose()
+  closeSync(ttyFd)
+  assert.ok(resolve(home).startsWith(resolve(prefix)))
+  rmSync(home, { recursive: true, force: true })
+}
