+/**
+ * Real channel history LRU + Chat/xterm fence-state regression. The target is
+ * opened by SGR mouse; unrelated chunks are materialized via channel.revealRow
+ * solely to force eviction. Synthetic records, no real sessions or credentials.
+ * Run: node --import tsx/esm scripts/verify-code-fence-lru.tsx
+ */
+import assert from 'node:assert/strict'
+import { closeSync, mkdtempSync, openSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, resolve } from 'node:path'
+import { PassThrough, Writable } from 'node:stream'
+
+// Ignore inherited harness paths and temp overrides: the fixture owns every
+// DSH/XDG destination and never writes a real terminal fd.
+for (const key of Object.keys(process.env)) if (key.startsWith('DSH_')) delete process.env[key]
+delete process.env.TMPDIR
+delete process.env.TMP
+delete process.env.TEMP
+const prefix = join(tmpdir(), 'code-fence-lru-')
+const home = mkdtempSync(prefix)
+process.env.HOME = home
+process.env.USERPROFILE = home
+process.env.DSH_HOME = join(home, '.dsh')
+process.env.XDG_CONFIG_HOME = join(home, '.config')
+process.env.XDG_CACHE_HOME = join(home, '.cache')
+process.env.XDG_DATA_HOME = join(home, '.local', 'share')
+process.env.XDG_STATE_HOME = join(home, '.local', 'state')
+process.env.DSH_TUI_LANG = 'en'
+process.env.FORCE_COLOR = '3'
+const [React, { Terminal }, { render, AlternateScreen }, { Chat }, { QuestionStore }, { createChannel }, { mountChannelUi }, { registerTuiChannel }, { settled, sleep }, { default: inkInstances }] = await Promise.all([
+  import('react'), import('@xterm/headless'), import('../src/ui.js'), import('../src/screens/Chat.js'),
+  import('../src/dsh-adapter/questions.js'), import('../src/dsh-adapter/channel.js'),
+  import('../src/dsh-adapter/channel-ui.js'), import('../src/adapter/channel/host-registry.js'),
+  import('./lib/term-test.mjs'), import('../src/ink/instances.js'),
+])
+type RawEvent = { type: string; seq: number; time: number; data: Record<string, unknown> }
+const events: RawEvent[] = []
+const append = (type: string, data: Record<string, unknown>) => {
+  const seq = events.length + 1
+  events.push({ type, seq, time: seq, data })
+}
+for (let n = 1; n <= 8; n++) {
+  append('user/message', { id: `user-${n}`, source: { kind: 'user' }, content: [{ type: 'text', text: `LRU-PROMPT-${n}` }] })
+  append('tool/call', { turn: n, step: 1, callId: `weight-${n}`, name: 'ask_user_question', arguments: JSON.stringify({ unused: 'x'.repeat(1_010_000) }) })
+  const text = `answer ${n}\n\n\`\`\`js\nA_HEAD_${n}\nA_BODY_${n}\n\`\`\`\n\n~~~py\nB_HEAD_${n}\nB_BODY_${n}\n~~~`
+  append('assistant/message', { turn: n, step: 1, message: { role: 'assistant', content: [{ type: 'text', text }] } })
+}
+const cleanups: Array<() => void> = []
+const agent = { id: 'lru-test', status: 'idle', session: { id: 'lru-session', seq: events.length, events, header: { cwd: home } }, ctx: { on: () => () => undefined }, followup() {}, steer() {}, cancel() {}, inbox: { remove: () => true } }
+const services: Record<string, unknown> = {
+  settings: { describe: () => [{ ns: 'llm-pi-ai', revision: 1, user: {}, value: {} }, { ns: 'dsh-tui', revision: 1, user: {}, value: { recapOnOpen: false } }], get: () => ({}), mutate: async () => undefined },
+  credentials: { resolve: async () => undefined, set: async () => undefined, unset: async () => undefined },
+  llm: { listConfigurableProviders: () => [], discoverModels: async () => [] },
+  agents: {},
+}
+const ctx = { on: () => () => undefined, effect(setup: () => () => void) { cleanups.push(setup()) }, get: (name: string) => services[name], logger: { warn() {} } }
+const raw = createChannel(ctx as never, agent as never, { model: 'model', provider: 'provider', cwd: home, activity: false, whale: false, whaleIdle: false, minimalUi: true, smoothStreaming: false })
+const unregister = registerTuiChannel(ctx, raw)
+const mount = mountChannelUi(ctx, raw, undefined, 'new')
+const summaries = () => mount.channel.rows.filter(row => row.collapsed === true)
+const targetSummary = summaries().find(row => row.collapsedTurns?.some(turn => turn.text === 'LRU-PROMPT-2'))
+const target = targetSummary?.collapsedTurns?.find(turn => turn.text === 'LRU-PROMPT-2')
+assert.ok(targetSummary && target, 'must seed seven independently evictable old chunks')
+assert.ok(summaries().length >= 7, 'each heavy round must occupy its own chunk')
+const COLS = 100, ROWS = 45
+const term = new Terminal({ cols: COLS, rows: ROWS, scrollback: 0, allowProposedApi: true })
+const ttyFd = openSync(join(home, 'tty-output'), 'w')
+let pendingWrites = 0
+let parsedWrites = 0
+let frames = 0
+class Stdout extends Writable {
+  columns = COLS; rows = ROWS; isTTY = true; fd = ttyFd
+  _write(chunk: unknown, _encoding: BufferEncoding, done: () => void) {
+    pendingWrites++
+    term.write(String(chunk), () => { pendingWrites--; parsedWrites++; done() })
+  }
+}
+class Stdin extends PassThrough {
+  isTTY = true
+  setRawMode() { return this }
+  ref() { return this }
+  unref() { return this }
+}
+const stdout = new Stdout(), stdin = new Stdin()
+const stderr = Object.assign(new Writable({ write(_chunk, _encoding, done) { done() } }), { isTTY: true })
+const lines = () => Array.from({ length: ROWS }, (_, y) => term.buffer.active.getLine(term.buffer.active.baseY + y)?.translateToString(true) ?? '')
+const has = (s: string) => lines().some(line => line.includes(s))
+type ProbeNode = {
+  nodeName?: string
+  nodeValue?: string
+  childNodes?: ProbeNode[]
+  scrollTop?: number
+  scrollHeight?: number
+  scrollViewportHeight?: number
+  scrollViewportTop?: number
+  stickyScroll?: boolean
+  yogaNode?: { getComputedTop(): number; getComputedHeight(): number }
+}
+const root = (): ProbeNode | undefined => (inkInstances.get(stdout as never) as unknown as { rootNode?: ProbeNode } | undefined)?.rootNode
+const walk = (node: ProbeNode | undefined, visit: (node: ProbeNode) => void): void => {
+  if (!node) return
+  visit(node)
+  for (const child of node.childNodes ?? []) walk(child, visit)
+}
+const textNode = (text: string): ProbeNode | undefined => {
+  let result: ProbeNode | undefined
+  walk(root(), node => { if (node.nodeValue?.includes(text)) result = node })
+  return result
+}
+const pathToText = (text: string): ProbeNode[] | undefined => {
+  const search = (node: ProbeNode | undefined, parents: ProbeNode[]): ProbeNode[] | undefined => {
+    if (!node) return undefined
+    const path = [...parents, node]
+    if (node.nodeValue?.includes(text)) return path
+    for (const child of node.childNodes ?? []) {
+      const found = search(child, path)
+      if (found) return found
+    }
+    return undefined
+  }
+  return search(root(), [])
+}
+// The LCA of the two code texts is Markdown's column; the four containing
+// boxes are Markdown's host, the bullet row, AssistantTextMessage, then the
+// settled TranscriptRow Box whose ref is registered with MessageList.
+const assistantRowRef = (): ProbeNode => {
+  const a = pathToText('A_BODY_2'), b = pathToText('B_HEAD_2')
+  assert.ok(a && b, 'both blocks must have mounted DOM nodes')
+  let common = 0
+  while (common < a.length && common < b.length && a[common] === b[common]) common++
+  const row = a[common - 1 - 4]
+  assert.ok(row?.nodeName === 'ink-box', `expected TranscriptRow Box at the shared Markdown path: ${a.map(node => node.nodeName).join(' > ')}`)
+  return row
+}
+const containsNode = (target: ProbeNode): boolean => {
+  let found = false
+  walk(root(), node => { if (node === target) found = true })
+  return found
+}
+const geometry = () => {
+  let scroll: ProbeNode | undefined
+  walk(root(), node => { if (node.scrollViewportHeight !== undefined) scroll = node })
+  return scroll && { top: scroll.scrollTop, height: scroll.scrollHeight, viewport: scroll.scrollViewportHeight, viewportTop: scroll.scrollViewportTop, sticky: scroll.stickyScroll }
+}
+const diagnostic = () => JSON.stringify({ frames, parsedWrites, pendingWrites, queuedBytes: stdout.writableLength, geometry: geometry(), mountedBody: textNode('A_BODY_2') !== undefined, summaries: summaries().map(row => row.id) })
+// A sentinel queues behind every earlier stdout write. The write callback
+// fires only after xterm's own parse callback, not merely after enqueueing.
+const drain = async (): Promise<void> => {
+  // Rendering may queue another write while the sentinel is being parsed.
+  // Drain those too; otherwise the screen can still be partway through a
+  // subsequent frame when the sentinel callback resolves.
+  for (let attempt = 0; attempt < 20; attempt++) {
+    await new Promise<void>((resolve, reject) => stdout.write('', error => error ? reject(error) : resolve()))
+    if (pendingWrites === 0 && stdout.writableLength === 0) return
+  }
+  assert.fail(`xterm output did not drain: ${diagnostic()}`)
+}
+const wait = async (name: string, predicate: () => boolean) => {
+  assert.ok(await settled(() => pendingWrites === 0 && stdout.writableLength === 0 && predicate(), { timeoutMs: 15000 }), `${name}\n${diagnostic()}\n${lines().join('\n')}`)
+  await drain()
+  assert.ok(predicate(), `${name} after xterm drain\n${diagnostic()}\n${lines().join('\n')}`)
+  console.log(`PASS: ${name}`)
+}
+const click = async (text: string) => {
+  await wait(`mouse target ${text}`, () => has(text))
+  const y = lines().findIndex(line => line.includes(text))
+  const x = lines()[y]!.indexOf(text) + 1
+  stdin.write(`\x1b[<0;${x};${y + 1}M\x1b[<0;${x};${y + 1}m`)
+}
+// Home edits the prompt; fullscreen Chat pages the transcript with PgUp.
+// Wait for an actual new frame and viewport motion after every page, rather
+// than guessing when scrolling/virtualization has converged.
+const pageUpTo = async (present: () => boolean): Promise<void> => {
+  for (let attempts = 0; attempts < 8 && !present(); attempts++) {
+    const before = geometry()?.top
+    assert.notEqual(before, undefined, `missing scroll geometry: ${diagnostic()}`)
+    assert.ok(before! > 0, `target absent at transcript top\n${diagnostic()}\n${lines().join('\n')}`)
+    const beforeFrame = frames
+    stdin.write('\x1b[5~')
+    await wait('PgUp paints actual transcript movement', () => frames > beforeFrame && ((geometry()?.top ?? before!) < before! || present()))
+  }
+  assert.ok(present(), `target must be reachable after bounded PgUp navigation\n${diagnostic()}\n${lines().join('\n')}`)
+}
+let app: Awaited<ReturnType<typeof render>> | undefined
+let rerenderCommitFrame: number | undefined
+const questionStore = new QuestionStore()
+function RerenderProbe({ generation }: { generation: number }): React.ReactNode {
+  React.useLayoutEffect(() => {
+    if (generation === 1) rerenderCommitFrame = frames
+  }, [generation])
+  return <AlternateScreen><Chat channel={mount.channel as never} questionStore={questionStore} fullscreen trajectorySeen /></AlternateScreen>
+}
+const tree = (generation = 0) => <RerenderProbe generation={generation} />
+try {
+  // Direct channel projection is used for setup, not to toggle disclosure.
+  mount.channel.revealRow(target.id)
+  const assistant = mount.channel.rows.find(row => row.kind === 'assistant' && row.text.includes('A_HEAD_2'))
+  assert.ok(assistant, 'target assistant must materialize')
+  app = await render(tree(), {
+    stdout: stdout as never, stdin: stdin as never, stderr: stderr as never, patchConsole: false, exitOnCtrlC: false,
+    onFrame: () => { frames++ },
+  })
+  await wait('initial Chat frame is ready', () => has('LRU-PROMPT-8'))
+  await pageUpTo(() => has('A_HEAD_2') && has('B_HEAD_2'))
+  await wait('target shows two independently folded blocks', () => has('A_HEAD_2') && has('B_HEAD_2') && !has('A_BODY_2') && !has('B_BODY_2'))
+  await click('A_HEAD_2')
+  await wait('SGR opens A only', () => has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'))
+  const oldRowRef = assistantRowRef()
+  assert.ok(containsNode(oldRowRef), 'the original assistant row ref must actually be mounted')
+  const beforeEvictionFrame = frames
+  for (const summary of summaries().filter(row => row.id !== targetSummary.id)) mount.channel.revealRow(summary.id)
+  assert.ok(summaries().some(row => row.id === targetSummary.id), 'target chunk must actually be evicted by the LRU')
+  console.log('PASS: real channel LRU evicted target chunk')
+  await wait('eviction paints a new frame and unmounts the original row ref', () => frames > beforeEvictionFrame && !containsNode(oldRowRef) && !has('A_BODY_2'))
+  console.log(`EVICTED ${diagnostic()}`)
+  const beforeRematerializeFrame = frames
+  mount.channel.revealRow(target.id)
+  assert.ok(mount.channel.rows.some(row => row.id === assistant.id && row.kind === 'assistant'), 'rematerialized row must keep its id')
+  console.log('PASS: rematerialized row retains its id')
+  await wait('rematerialization schedules a fresh frame', () => frames > beforeRematerializeFrame)
+  await pageUpTo(() => (has('A_BODY_2') || has('A_HEAD_2')) && has('B_HEAD_2'))
+  await wait('real LRU rematerialization keeps A open and B closed', () => textNode('A_BODY_2') !== undefined && has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'))
+  assert.notEqual(assistantRowRef(), oldRowRef, 'rematerialization must mount a new assistant row ref')
+  console.log(`RESTORED ${diagnostic()}`)
+  app.rerender(tree(1))
+  await wait('independent React rerender commits and produces a later frame', () => rerenderCommitFrame !== undefined && frames > rerenderCommitFrame)
+  assert.ok(has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'), `rerender must preserve A open / B closed\n${diagnostic()}\n${lines().join('\n')}`)
+  const ink = inkInstances.get(stdout as never)
+  assert.ok(ink, 'the fake stdout must own an Ink instance')
+  const beforeRedrawFrame = frames
+  ink.forceRedraw()
+  await wait('independent full redraw produces a new parsed frame', () => frames > beforeRedrawFrame)
+  assert.ok(has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'), `full redraw must preserve A open / B closed\n${diagnostic()}\n${lines().join('\n')}`)
+  console.log(`REDRAWN ${diagnostic()}`)
+  await sleep(200) // 固定窗:探针 no delayed layout update may undo the fresh redraw
+  await drain()
+  assert.ok(has('A_BODY_2') && has('B_HEAD_2') && !has('B_BODY_2'), `restored state must remain stable after redraw\n${diagnostic()}\n${lines().join('\n')}`)
+  console.log(`PASS: restored state stays stable after redraw ${diagnostic()}`)
+} finally {
+  if (app) await app.unmount()
+  await drain()
+  mount.dispose(); unregister(); raw.releaseContributions()
+  for (const cleanup of cleanups.reverse()) cleanup()
+  term.dispose()
+  closeSync(ttyFd)
+  assert.ok(resolve(home).startsWith(resolve(prefix)))
+  rmSync(home, { recursive: true, force: true })
+}
diff --git a/scripts/verify-digest-click.tsx b/scripts/verify-digest-click.tsx
new file mode 100644
index 00000000..9194f693
--- /dev/null
+++ b/scripts/verify-digest-click.tsx
@@ -0,0 +1,145 @@
+/**
+ * A collapsed history chunk paints ONE digest line. That line is the load
+ * control for its chunk: clicking it calls `onRevealCollapsed(rowId)` so the
+ * chunk is projected in place. Before this the only way to read old history
+ * was to scroll to the very top and press the "load earlier" pager, then find
+ * the place again — the reported rail-era annoyance.
+ *
+ * A plain `notice` divider (compact summary, no `collapsed` flag) must stay
+ * inert: it carries no loadable region.
+ *
+ * Mouse hit-testing, the row's click handler and the divider chrome are all
+ * production code; only the channel call is a spy.
+ *
+ * Run: node --import tsx/esm scripts/verify-digest-click.tsx
+ */
+process.env.NODE_ENV = 'production'
+process.env.FORCE_COLOR = '3'
+process.env.DSH_TUI_LANG = 'en'
+import '../src/force-production-react.js'
+
+import assert from 'node:assert/strict'
+import { PassThrough, Writable } from 'node:stream'
+import type { ScrollBoxHandle } from '../src/ui.js'
+import type { ChatRow } from '../src/dsh-adapter/channel.js'
+import type { DOMElement } from '../src/ink/dom.js'
+import { settled, sleep } from './lib/term-test.mjs'
+
+const [React, { Box, render, ScrollBox }, { MessageList }, { nodeCache }] = await Promise.all([
+  import('react'),
+  import('../src/ui.js'),
+  import('../src/components/MessageList.js'),
+  import('../src/ink/node-cache.js'),
+])
+
+class Input extends PassThrough {
+  isTTY = true
+  setRawMode() { return this }
+  ref() { return this }
+  unref() { return this }
+}
+class Sink extends Writable {
+  isTTY = true
+  columns = 100
+  rows = 30
+  _write(_chunk: unknown, _encoding: BufferEncoding, done: () => void) { done() }
+}
+
+const ROWS_N = 200
+const DIGEST_ID = 199
+const DIGEST_TURNS = [
+  { id: -2_000_001, seq: 900_001, text: 'OLD-PROMPT-1', imageCount: 0 },
+  { id: -2_000_002, seq: 900_002, text: 'OLD-PROMPT-2', imageCount: 0 },
+]
+const PLAIN_NOTICE_ID = 198
+
+const rows: ChatRow[] = Array.from({ length: ROWS_N }, (_, i): ChatRow => {
+  const id = i + 1
+  if (id === DIGEST_ID) {
+    return {
+      id,
+      kind: 'notice',
+      text: '3 earlier turns',
+      collapsed: true,
+      collapsedTurns: DIGEST_TURNS,
+      restored: true,
+    }
+  }
+  if (id === PLAIN_NOTICE_ID) return { id, kind: 'notice', text: 'session compacted' }
+  if (id % 4 === 0) return { id, kind: 'user', text: `turn ${id / 4}` }
+  return {
+    id, kind: 'tool', text: '',
+    tool: {
+      callId: `call-${id}`, name: 'Read', argsText: `module-${id}.ts`,
+      status: 'ok', startedAt: 0, durationMs: 5,
+      resultText: `source ${id} first\nsource ${id} second`,
+    },
+  }
+})
+
+let handle: ScrollBoxHandle | null = null
+const mounted = new Map<number, DOMElement>()
+const expandedRows = new Set<number>()
+const revealed: number[] = []
+const noop = (): void => {}
+const registerRowRef = (id: number, el: DOMElement | null): void => {
+  if (el) mounted.set(id, el)
+  else mounted.delete(id)
+}
+
+function Harness(): React.ReactElement {
+  const [scroll, setScroll] = React.useState<ScrollBoxHandle | null>(null)
+  handle = scroll
+  return <Box flexDirection="column" height={24}>
+    <ScrollBox ref={setScroll} height={20} stickyScroll flexDirection="column">
+      <MessageList rows={rows} expanded={false} expandedRows={expandedRows} selectedId={null}
+        onToggleRow={noop} model="test" showAll={false} onToggleAll={noop}
+        onRevealCollapsed={(id: number) => { revealed.push(id) }}
+        registerRowRef={registerRowRef} scrollHandle={scroll} />
+    </ScrollBox>
+  </Box>
+}
+
+const stdout = new Sink()
+const app = await render(<Harness />, {
+  stdout: stdout as unknown as NodeJS.WriteStream,
+  stdin: new Input() as unknown as NodeJS.ReadStream,
+  stderr: new Sink() as unknown as NodeJS.WriteStream,
+  exitOnCtrlC: false, patchConsole: false,
+})
+try {
+  assert.ok(await settled(() => handle !== null && mounted.has(DIGEST_ID) && mounted.has(PLAIN_NOTICE_ID)),
+    'the tail window must mount both dividers')
+
+  const { dispatchClick } = await import('../src/ink/hit-test.js')
+  const { default: inkInstances } = await import('../src/ink/instances.js')
+  const rootNode = (inkInstances.get(stdout as never) as unknown as { rootNode?: DOMElement } | undefined)?.rootNode
+  assert.ok(rootNode !== undefined, 'the ink root must exist')
+
+  const digest = mounted.get(DIGEST_ID)!
+  const rect = nodeCache.get(digest)
+  assert.ok(rect !== undefined, 'the digest line must have a laid-out rect')
+  // Hit-testing reads root-space geometry, so no terminal is needed. Click the
+  // divider's own line, one column in; a blank gutter cell would be ignored by
+  // the fold handlers, but this row's load control has no blank guard.
+  // 固定窗:pacing 吸底尾巴挂载后仍在测量行高，没有单一可轮询的落定锚点
+  await sleep(200)
+  const topBefore = handle!.getScrollTop()
+  const hit = dispatchClick(rootNode!, rect!.x + 2, rect!.y)
+  assert.equal(hit, true, 'the digest line must consume the click')
+  assert.deepEqual(revealed, [DIGEST_ID], 'the click must project exactly the clicked chunk')
+
+  const plain = mounted.get(PLAIN_NOTICE_ID)!
+  const plainRect = nodeCache.get(plain)
+  assert.ok(plainRect !== undefined)
+  const plainHit = dispatchClick(rootNode!, plainRect!.x + 2, plainRect!.y)
+  assert.equal(plainHit, false, 'a plain notice divider must not be clickable')
+  assert.deepEqual(revealed, [DIGEST_ID], 'a plain notice must not request a load')
+
+  // The click must not have moved the reader: the digest loads in place.
+  await sleep(200) // 固定窗:探针 let any post-click re-anchor pass run
+  assert.equal(handle!.getScrollTop(), topBefore, 'projecting a chunk in place must not scroll the reader')
+  console.log('PASS: digest line projects its chunk on click; plain notices stay inert')
+} finally {
+  await app.unmount()
+}
diff --git a/scripts/verify-dsh-fold-back-restored.ts b/scripts/verify-dsh-fold-back-restored.ts
new file mode 100644
index 00000000..bbfb8570
--- /dev/null
+++ b/scripts/verify-dsh-fold-back-restored.ts
@@ -0,0 +1,148 @@
+/**
+ * `foldBack` (the DSH backend's "load earlier") restores folded rows from the
+ * durable session log. It cleared `folded` but never set `restored`, and
+ * `foldRows` exempts a row from the next pass on `row.folded || row.restored`
+ * (`src/dsh-adapter/channel/transcript.ts`, the `if (row.folded || row.restored)
+ * continue` guard).
+ *
+ * On the DSH backend that guard is not academic: the channel folds on every
+ * `emit()`/`wake()`, i.e. once per streaming frame. A row that "load earlier"
+ * had just restored was therefore folded again by the very next frame — the
+ * press appeared to do nothing, and the full text it had just read back out of
+ * the session log was dropped almost immediately. The Claude path already
+ * survives this because its history restore sets the same flag
+ * (`src/channel/history-restore.ts`); this file pins DSH to that behaviour.
+ *
+ * Run: node --import tsx/esm scripts/verify-dsh-fold-back-restored.ts
+ */
+const { foldBack, foldRows, MAX_ROWS } = await import('../src/dsh-adapter/channel/transcript.js')
+type SessionEvent = import('@deepseek-ai/dsh-session').SessionEvent
+type ChatRow = import('../src/dsh-adapter/channel/types.js').ChatRow
+
+let passed = 0
+function check(label: string, ok: boolean, detail?: unknown): void {
+  if (!ok) {
+    console.error(`\n  ✗ ${label}`, detail === undefined ? '' : detail)
+    process.exit(1)
+  }
+  passed += 1
+  console.log(`  ✓ ${label}`)
+}
+
+let nextId = 1
+const textRow = (seq: number, text = 'full text the row shows once restored'): ChatRow => ({
+  id: nextId++,
+  kind: 'assistant',
+  text,
+  folded: true,
+  seq,
+})
+const toolRow = (seq: number, callId: string): ChatRow => ({
+  id: nextId++,
+  kind: 'tool',
+  text: 'preview',
+  folded: true,
+  seq,
+  tool: { callId, name: 'read_file', argsText: '{}', status: 'ok' } as ChatRow['tool'],
+})
+const message = (seq: number, text = 'restored assistant text'): SessionEvent =>
+  ({ seq, type: 'assistant/message', data: { message: { content: [{ type: 'text', text }] } } }) as unknown as SessionEvent
+const call = (seq: number): SessionEvent =>
+  ({ seq, type: 'tool/call', data: { name: 'read_file', arguments: { path: 'a.ts' } } }) as unknown as SessionEvent
+
+// ── the flag itself ──────────────────────────────────────────────────────────
+
+{
+  const rows = [textRow(1)]
+  foldBack(rows, [message(1)])
+  check('a restored text row is marked `restored`', rows[0]!.restored === true, { row: rows[0] })
+}
+
+{
+  const rows = [toolRow(2, 'c1')]
+  foldBack(rows, [call(2)])
+  check('a restored tool row is marked `restored`', rows[0]!.restored === true, { row: rows[0] })
+}
+
+{
+  const rows = [textRow(50)]
+  foldBack(rows, [message(1)])
+  check('a row the log cannot answer is NOT marked `restored`', rows[0]!.restored !== true, { row: rows[0] })
+}
+
+// ── the regression: the next fold pass must leave it alone ───────────────────
+//
+// This is the actual bug. Build a window that is over the cap, restore it the
+// way a press does, then run the fold pass the next streaming frame runs.
+
+{
+  const rows: ChatRow[] = []
+  const events: SessionEvent[] = []
+  for (let i = 0; i < MAX_ROWS + 200; i++) {
+    rows.push(textRow(i + 1, `full text ${i + 1}`))
+    events.push(message(i + 1, `full text ${i + 1}`))
+  }
+  const restored = foldBack(rows, events)
+  check('the press restores the folded tail', restored > 0, { restored })
+
+  const keptText = rows.map(row => row.text)
+  const foldedAgain = foldRows(rows, MAX_ROWS)
+  check('the next fold pass folds nothing back', foldedAgain === 0, { foldedAgain })
+  check(
+    'every restored row keeps its full text',
+    rows.every((row, i) => row.text === keptText[i] && row.folded === false),
+    { changed: rows.filter((row, i) => row.text !== keptText[i]).length },
+  )
+}
+
+// …and the guard really is what stops it: without the flag, the same pass
+// folds everything back. Asserting this keeps the test honest — if `foldRows`
+// ever stops honouring `restored`, the check above would pass vacuously.
+{
+  const rows: ChatRow[] = []
+  const events: SessionEvent[] = []
+  for (let i = 0; i < MAX_ROWS + 200; i++) {
+    rows.push(textRow(i + 1, `full text ${i + 1}`))
+    events.push(message(i + 1, `full text ${i + 1}`))
+  }
+  foldBack(rows, events)
+  for (const row of rows) row.restored = false // pretend the flag was never set
+  check('without the flag the same pass folds the window back', foldRows(rows, MAX_ROWS) > 0)
+}
+
+// ── the exemption must not disable folding ──────────────────────────────────
+//
+// Folding acts on the rows BELOW the fold line (the oldest `excess` rows); the
+// exemption is per row, not a switch. A session that keeps streaming after a
+// restore must still fold the rows that reach the fold line, or a long session
+// would grow without bound. Push enough new rows that some of them fall below
+// the line, and check exactly those fold while the restored ones do not.
+
+{
+  const rows: ChatRow[] = []
+  const events: SessionEvent[] = []
+  for (let i = 0; i < MAX_ROWS + 200; i++) {
+    rows.push(textRow(i + 1, `full text ${i + 1}`))
+    events.push(message(i + 1, `full text ${i + 1}`))
+  }
+  foldBack(rows, events)
+  const restoredCount = rows.length
+  for (let i = 0; i < MAX_ROWS + 200; i++) {
+    rows.push({ id: nextId++, kind: 'assistant', text: `streamed ${i}`, folded: false, seq: restoredCount + i + 1 })
+  }
+  const excess = rows.length - MAX_ROWS
+  const belowLine = rows.slice(0, excess)
+  const freshBelowLine = belowLine.filter(row => row.restored !== true)
+  const foldedNow = foldRows(rows, MAX_ROWS)
+  check(
+    'rows reaching the fold line after a restore still fold',
+    freshBelowLine.length > 0 && foldedNow === freshBelowLine.length,
+    { freshBelowLine: freshBelowLine.length, foldedNow },
+  )
+  check(
+    '…while every restored row below the line stays intact',
+    belowLine.filter(row => row.restored === true).every(row => row.folded === false),
+  )
+}
+
+console.log(`\nverify-dsh-fold-back-restored OK (${passed} checks)`)
diff --git a/scripts/verify-dsh-fold-back.ts b/scripts/verify-dsh-fold-back.ts
new file mode 100644
index 00000000..d07fb194
--- /dev/null
+++ b/scripts/verify-dsh-fold-back.ts
@@ -0,0 +1,317 @@
+/**
+ * `foldBack` (the DSH backend's "load earlier") restores folded rows from the
+ * durable session log. It is a synchronous click handler budgeted at ≤50 ms
+ * (`docs/codex-backend-design.md` §10.7), but the loop ran one full linear
+ * scan of the restore window per folded row: a titan session that folded tens
+ * of thousands of rows past MAX_ROWS took seconds to answer one press.
+ *
+ * This pins the fix — one bounded pass builds `seq → tool/call` and the
+ * assistant/message cursor, every lookup is a map hit or a binary search —
+ * and proves it preserves the per-row scan's assistant/tool behavior, with
+ * exact-seq, preview-verified user restoration added separately:
+ *
+ *  - a tool row whose call event is absent stays folded, and a non-call event
+ *    sharing its seq does NOT shadow a real call elsewhere in the window (the
+ *    scan skipped non-call events and kept looking; the index must too);
+ *  - a text row takes the FIRST assistant/message at or after its anchor, not
+ *    the nearest one before it (a row anchored mid-step still settles on the
+ *    step's message);
+ *  - a message repeated at several seqs resolves to the earliest, and a row
+ *    anchored past every message stays folded;
+ *  - seqs below the first folded row never answer, even when they match;
+ *  - the tool view re-derivation (`views`) still runs for restored call rows
+ *    and is skipped for a row whose result never arrived.
+ *
+ * Run: node --import tsx/esm scripts/verify-dsh-fold-back.ts
+ */
+import assert from 'node:assert/strict'
+import { withoutTeammateReminder } from '../src/dsh-adapter/compat/agent-team-0.2.0.js'
+import { preview } from '../src/channel/transcript.js'
+
+const { foldBack } = await import('../src/dsh-adapter/channel/transcript.js')
+type SessionEvent = import('@deepseek-ai/dsh-session').SessionEvent
+type ChatRow = import('../src/dsh-adapter/channel/types.js').ChatRow
+type ToolViewPresenter = import('../src/dsh-adapter/channel/types.js').ToolViewPresenter
+
+let passed = 0
+function check(label: string, ok: boolean, detail?: unknown): void {
+  if (!ok) {
+    console.error(`\n  ✗ ${label}`, detail === undefined ? '' : detail)
+    process.exit(1)
+  }
+  passed += 1
+  console.log(`  ✓ ${label}`)
+}
+
+/** Linear oracle for the original assistant/tool behavior and the new user contract. */
+function foldBackOracle(rows: ChatRow[], events: readonly SessionEvent[], views?: ToolViewPresenter): number {
+  const folded = rows.filter(row => row.folded)
+  if (folded.length === 0) return 0
+  const firstFoldedSeq = folded[0]?.seq ?? 0
+  const restoreEvents = events.filter(event => event.seq >= firstFoldedSeq)
+  const resultsByCall = new Map<string, SessionEvent<'tool/result'>>()
+  for (const event of restoreEvents) {
+    if (event.type === 'tool/result') {
+      resultsByCall.set(event.data.message.source.callId, event)
+    }
+  }
+  let restored = 0
+  for (const row of folded) {
+    const rowSeq = row.seq
+    if (rowSeq === undefined) continue
+    if (row.kind === 'user') {
+      const event = events.find(event => event.seq === rowSeq && event.type === 'user/message')
+      if (event === undefined || event.type !== 'user/message' || event.data.source?.kind !== 'user' || row.label === 'team-message') continue
+      const firstText = (content: typeof event.data.content): string => content.find(block => block.type === 'text')?.text.trim() ?? ''
+      const candidates = new Set([firstText(event.data.content), firstText(withoutTeammateReminder(event.data).content)]
+        .filter(text => preview(text, 200) === row.text))
+      if (candidates.size !== 1) continue
+      row.text = candidates.values().next().value!
+      row.folded = false
+      restored += 1
+      continue
+    }
+    if (row.kind === 'tool' && row.tool !== undefined) {
+      const call = restoreEvents.find(event => event.seq === rowSeq && event.type === 'tool/call')
+      if (call === undefined || call.type !== 'tool/call') continue
+      restoreRowFromEvent(row, call)
+      const result = resultsByCall.get(row.tool.callId)
+      if (result !== undefined) restoreToolResult(row, result)
+      row.tool.callView = views?.call(call.data.name, call.data.arguments)
+      row.tool.resultView = result !== undefined && row.tool.status === 'ok'
+        ? views?.result(call.data.name, call.data.arguments, result.data)
+        : undefined
+      row.folded = false
+      restored += 1
+      continue
+    }
+    const message = restoreEvents.find(event => event.seq >= rowSeq && event.type === 'assistant/message')
+    if (message === undefined) continue
+    restoreRowFromEvent(row, message)
+    row.folded = false
+    restored += 1
+  }
+  return restored
+}
+
+// The oracle needs the two restore helpers; the module exports them.
+const { restoreRowFromEvent, restoreToolResult } = await import('../src/dsh-adapter/channel/transcript.js')
+
+let nextId = 1
+const toolRow = (seq: number | undefined, callId: string, status: 'ok' | 'error' = 'ok'): ChatRow => ({
+  id: nextId++,
+  kind: 'tool',
+  text: 'preview',
+  folded: true,
+  ...seq === undefined ? {} : { seq },
+  tool: { callId, name: 'read_file', argsText: '{}', status } as ChatRow['tool'],
+})
+const textRow = (kind: 'assistant' | 'reasoning', seq: number | undefined): ChatRow => ({
+  id: nextId++,
+  kind,
+  text: 'preview',
+  folded: true,
+  ...seq === undefined ? {} : { seq },
+})
+
+const ev = {
+  call: (seq: number, name = 'read_file', args: unknown = { path: 'a.ts' }) =>
+    ({ seq, type: 'tool/call', data: { name, arguments: args } }) as unknown as SessionEvent,
+  result: (seq: number, callId: string, text = 'R'.repeat(40)) =>
+    ({
+      seq,
+      type: 'tool/result',
+      data: { message: { source: { callId }, content: [{ type: 'text', text }] } },
+    }) as unknown as SessionEvent,
+  message: (seq: number, text: string, reasoning?: string) =>
+    ({
+      seq,
+      type: 'assistant/message',
+      data: {
+        message: {
+          content: [
+            ...reasoning === undefined ? [] : [{ type: 'reasoning', text: reasoning }],
+            { type: 'text', text },
+          ],
+        },
+      },
+    }) as unknown as SessionEvent,
+  user: (seq: number, text: string) =>
+    ({ seq, type: 'user/message', data: { source: { kind: 'user' }, content: [{ type: 'text', text }] } }) as unknown as SessionEvent,
+}
+
+/** Run both implementations on identical inputs and diff the outcome. */
+function same(label: string, makeRows: () => ChatRow[], makeEvents: () => SessionEvent[], withViews = false): number {
+  const views: ToolViewPresenter | undefined = withViews
+    ? {
+        call: (name: string, args: unknown) => ({ kind: 'call', name, args }) as never,
+        result: (name: string, args: unknown, data: unknown) => ({ kind: 'result', name, args, data }) as never,
+      }
+    : undefined
+  const a = makeRows()
+  const b = makeRows()
+  const eventsA = makeEvents()
+  const eventsB = makeEvents()
+  const wantRestored = foldBackOracle(a, eventsA, views)
+  const gotRestored = foldBack(b, eventsB, views)
+  const snapshot = (rows: ChatRow[]) => JSON.stringify(rows.map(row => ({
+    kind: row.kind, seq: row.seq ?? null, folded: row.folded === true,
+    text: row.text,
+    argsFull: row.tool?.argsFull ?? null,
+    resultFull: row.tool?.resultFull ?? null,
+    callView: row.tool?.callView ?? null,
+    resultView: row.tool?.resultView ?? null,
+  })))
+  assert.equal(gotRestored, wantRestored, `${label}: restored count`)
+  assert.equal(snapshot(b), snapshot(a), `${label}: row state`)
+  check(label, true)
+  return gotRestored
+}
+
+// ── behaviour the oracle's linear scan defines ────────────────────────────────
+
+same('a user row restores only its matching prompt', () => [
+  { id: nextId++, kind: 'user', seq: 1, text: preview('prompt '.repeat(50), 200), folded: true },
+], () => [ev.user(1, 'prompt '.repeat(50)), ev.message(2, 'answer')])
+
+same('a user row with a mismatched preview stays folded', () => [
+  { id: nextId++, kind: 'user', seq: 1, text: 'wrong preview', folded: true },
+], () => [ev.user(1, 'prompt'), ev.message(2, 'answer')])
+
+same('a tool row takes the call event at its own seq, and its result by callId', () => [
+  toolRow(4, 'c1'),
+], () => [ev.call(4), ev.result(7, 'c1')], true)
+
+same('a tool row whose call event is missing stays folded', () => [
+  toolRow(4, 'c1'),
+], () => [ev.result(7, 'c1')])
+
+same('a tool result whose seq is not on the row is still matched by callId', () => [
+  toolRow(2, 'zz'),
+], () => [ev.call(2), ev.result(99, 'zz')])
+
+same('a tool row needs a tool/call at its seq: another event type there does not answer it', () => [
+  toolRow(3, 'c1'),
+], () => [ev.user(3, 'hi'), ev.message(3, 'text')])
+
+same('a text row settles on the FIRST message at or after its anchor', () => [
+  textRow('assistant', 5),
+], () => [ev.message(2, 'earlier'), ev.message(9, 'later'), ev.message(12, 'latest')])
+
+same('… a message at exactly the anchor wins over a later one', () => [
+  textRow('assistant', 9),
+], () => [ev.message(9, 'at anchor'), ev.message(12, 'later')])
+
+same('… a row anchored past every message stays folded', () => [
+  textRow('assistant', 50),
+], () => [ev.message(9, 'earlier only')])
+
+same('duplicate messages at several seqs resolve to the earliest', () => [
+  textRow('assistant', 4), textRow('assistant', 10),
+], () => [ev.message(4, 'first'), ev.message(10, 'second')])
+
+same('a reasoning row restores from the message reasoning block', () => [
+  textRow('reasoning', 3),
+], () => [ev.message(3, 'answer text', 'thinking text')])
+
+same('seqs below the first folded row never answer', () => [
+  textRow('assistant', 20),
+], () => [ev.message(5, 'too old'), ev.message(20, 'the one')])
+
+same('the same tool/call seq reused later still answers from the first call', () => [
+  toolRow(6, 'c1'),
+], () => [ev.call(6), ev.call(6), ev.result(6, 'c1')], true)
+
+same('a row with no seq stays folded', () => [
+  textRow('assistant', undefined), toolRow(undefined, 'c1'),
+], () => [ev.message(1, 'x'), ev.call(1)])
+
+same('a tool row with no tool model stays folded', () => [
+  { id: nextId++, kind: 'tool', text: 'p', folded: true, seq: 1 } as ChatRow,
+], () => [ev.call(1)])
+
+same('an error tool row restores its call view but no result view', () => [
+  toolRow(2, 'c1', 'error'),
+], () => [ev.call(2), ev.result(3, 'c1')], true)
+
+same('a mix restores the restorable half in one press', () => [
+  textRow('assistant', 1), toolRow(2, 'c1'), textRow('assistant', 4),
+  textRow('assistant', 30), toolRow(31, 'gone'),
+], () => [ev.message(1, 'a'), ev.call(2), ev.result(3, 'c1'), ev.message(4, 'b'), ev.message(6, 'c')], true)
+
+// ── the container is marked dirty once, and only when something came back ────
+
+{
+  const rows = [textRow('assistant', 1)]
+  const restored = foldBack(rows, [ev.message(1, 'a')])
+  check('a restore clears the folded mark', restored === 1 && rows[0]!.folded === false)
+  check('an already-thawed window returns 0 without touching anything', foldBack([textRow('assistant', 1)].map(r => ({ ...r, folded: false })), []) === 0)
+}
+
+// ── the reason this exists: one press must stay inside the click budget ──────
+//
+// A single timed call would mostly measure V8 warming up this function, which
+// is why the budget is checked against the MEDIAN of repeated presses: a user
+// clicks "load earlier" far more than once per process, and only the steady
+// state is what the ≤50 ms budget describes. The oracle is timed on the same
+// fixture (at a smaller size — its per-row scan is quadratic, so 20k there
+// costs seconds) to pin the reason for the win, not just the number.
+
+/** Slice of a synthetic titan session: `i` tool + text row pairs, seq-ordered. */
+function titanFixture(folded: number): { makeRows: () => ChatRow[]; events: SessionEvent[] } {
+  const events: SessionEvent[] = []
+  for (let i = 0; i < folded; i += 1) {
+    const seq = i * 4
+    events.push(ev.call(seq), ev.result(seq + 1, `c${i}`), ev.message(seq + 2, `m${i} ${'x'.repeat(400)}`))
+  }
+  const makeRows = (): ChatRow[] => {
+    const rows: ChatRow[] = []
+    for (let i = 0; i < folded; i += 1) {
+      const seq = i * 4
+      rows.push(i % 2 === 0 ? toolRow(seq, `c${i}`) : textRow('assistant', seq + 2))
+    }
+    return rows
+  }
+  return { makeRows, events }
+}
+
+/** Median of `runs` timings of one foldBack over a fresh fixture each time. */
+function press(fn: (rows: ChatRow[]) => number, makeRows: () => ChatRow[], runs: number): { ms: number; restored: number } {
+  const times: number[] = []
+  let restored = 0
+  for (let run = 0; run < runs; run += 1) {
+    const rows = makeRows()
+    const t0 = process.hrtime.bigint()
+    restored = fn(rows)
+    times.push(Number(process.hrtime.bigint() - t0) / 1e6)
+  }
+  times.sort((a, b) => a - b)
+  return { ms: times[times.length >>> 1]!, restored }
+}
+
+{
+  const FOLDED = 20_000
+  const titan = titanFixture(FOLDED)
+  foldBack(titan.makeRows(), titan.events) // warm the JIT once before timing
+  const { ms, restored } = press((rows) => foldBack(rows, titan.events), titan.makeRows, 5)
+  check(
+    `${FOLDED} folded rows restore in ${ms.toFixed(1)} ms median (budget ≤50 ms)`,
+    restored === FOLDED && ms < 50,
+    { restored, ms },
+  )
+
+  const SMALL = 2_000
+  const small = titanFixture(SMALL)
+  foldBackOracle(small.makeRows(), small.events)
+  foldBack(small.makeRows(), small.events)
+  const before = press((rows) => foldBackOracle(rows, small.events), small.makeRows, 3)
+  const after = press((rows) => foldBack(rows, small.events), small.makeRows, 3)
+  check(
+    `the one-pass index beats the per-row scan (${SMALL} rows: ${before.ms.toFixed(1)} → ${after.ms.toFixed(1)} ms)`,
+    before.restored === after.restored && after.ms * 5 < before.ms,
+    { before, after },
+  )
+}
+
+console.log(`\nverify-dsh-fold-back OK (${passed} checks)`)
+process.exit(0)
