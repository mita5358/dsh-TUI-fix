+      if (s.observed > limit && !s.overflow) { s.overflow = true; stop(`${key}-overflow`) }
+    })
+    child[key].on('error', err => { error ??= `${key}: ${String(err)}`; stop(`${key}-error`) })
+  }
+  child.on('error', err => { error ??= String(err) })
