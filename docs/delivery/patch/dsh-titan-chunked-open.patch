+    import('../src/screens/Chat.js'), import('../src/dsh-adapter/questions.js'), import('./lib/term-test.mjs'),
+  ])
+  const labels = { completed: ['🟢', 'completed'], failed: ['🔴', 'failed'], cancelled: ['🔴', 'Cancelled'], unknown: ['⚪', 'status unknown'] }
