+import { basename, dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+let scratch
+async function main() {
+  const tempRoot = realpathSync(tmpdir())
+  scratch = realpathSync(mkdtempSync(join(tempRoot, 'dsh-scroll-anchor-overscroll-')))
