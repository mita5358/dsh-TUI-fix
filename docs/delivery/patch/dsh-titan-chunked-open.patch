+++ b/scripts/verify-file-target-slash-performance.ts
@@ -0,0 +1,92 @@
+/**
+ * Focused slash and punctuation regression. The timing check compares the
+ * actual fileTarget export to the same-process legacy oracle; deterministic
+ * operation-count and output/OSC8 checks are independent hard requirements.
+ * Run serially: nice -n 10 node --import tsx/esm scripts/verify-file-target-slash-performance.ts
+ */
+import assert from 'node:assert/strict'
+import { performance } from 'node:perf_hooks'
+import { fileLinkUrl, linkifyFilePaths, looksLikeFilePath } from '../src/utils/fileTarget.js'
+import { createHyperlink } from '../src/terminal-utils/hyperlink.js'
+
+type Wrap = (path: string, display: string) => string
+const pattern = /(?:\.{1,2}[\\/]|[\\/]|~[\\/]|[A-Za-z]:[\\/])[^\s<>"'`|?#]*|(?:[^\s<>"'`|?#]*[\\/][^\s<>"'`|?#]*\.[A-Za-z0-9]{1,6})/gu
+function legacy(text: string, wrap: Wrap): string {
+  if (!text.includes('/') && !text.includes('\\')) return text
+  return text.replace(pattern, (match: string, offset: number, full: string) => {
+    if (offset > 0 && !/[\s<>"'`|([{=]/u.test(full[offset - 1]!)) return match
+    const display = match.replace(/[.,;:!?]+$/u, '')
+    if (display === '' || !looksLikeFilePath(display)) return match
+    return wrap(display, display) + match.slice(display.length)
+  })
+}
+// Keep the old-version run meaningful: missing candidate module is recorded,
+// not substituted with a hand-written guard or silently skipped. Raw legacy
+// and actual-source timings are still reported before the gate fails.
+let scanner: typeof import('../src/utils/pathSpan.js') | undefined
+let missingScanner: unknown
+try { scanner = await import('../src/utils/pathSpan.js') }
+catch (error) {
+  if (!(error instanceof Error) || !('code' in error) || error.code !== 'ERR_MODULE_NOT_FOUND' || !error.message.includes('pathSpan')) throw error
+  missingScanner = error
+}
+const noWrap: Wrap = () => { throw new Error('adversarial input must not invoke wrap') }
+const fixtures = [
+  { name: 'trailing-slash', value: 'a'.repeat(8000) + '/' },
+  { name: 'failed-punctuation-tail', value: '/' + '.'.repeat(4000) + 'x' },
+]
+const samples: Record<string, { source: number[]; legacy: number[] }> = {}
+for (const { name, value } of fixtures) {
+  const raw = samples[name] = { source: [], legacy: [] }
+  for (const size of [64, 128]) {
+    const input = value.slice(0, size)
+    assert.equal(linkifyFilePaths(input, noWrap), legacy(input, noWrap), `${name} warmup`)
+  }
+  const sample = (label: 'source' | 'legacy', fn: (text: string, wrap: Wrap) => string) => {
+    const start = performance.now()
+    const output = fn(value, noWrap)
+    const elapsed = performance.now() - start
+    assert.equal(output, value, `${name} ${label} must preserve output`)
+    raw[label].push(elapsed)
+  }
+  for (let round = 0; round < 5; round++) {
+    if (round % 2 === 0) { sample('legacy', legacy); sample('source', linkifyFilePaths) }
+    else { sample('source', linkifyFilePaths); sample('legacy', legacy) }
+  }
+}
+const median = (values: number[]) => [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]!
+for (const [name, raw] of Object.entries(samples)) {
+  const source = median(raw.source)
+  const reference = median(raw.legacy)
+  console.log(`PERF ${name} raw_ms=${JSON.stringify(raw)} source_median=${source} legacy_median=${reference} ratio=${source / reference}`)
+  assert.ok(reference > 0 && Number.isFinite(reference), `${name}: legacy timing is not measurable`)
+  // A noisy runner can fail this relative gate and must be investigated.
+  assert.ok(source < reference * 0.5, `${name}: source is not substantially faster than same-process legacy`)
+}
+
+// Deterministic gates measure the SAME exported scanner/trim helpers used by
+// fileTarget, not a test-side scanner. The old checkout lacks these exports.
+assert.ok(scanner, `candidate scan helpers unavailable: ${String(missingScanner)}`)
+for (const n of [1000, 4000, 8000, 100000]) {
+  for (const input of ['a'.repeat(n) + '/', '/' + 'a'.repeat(n), '/' + '.'.repeat(n) + 'x']) {
+    const stats = { steps: 0 }
+    const found = [...scanner.scanPathSpans(input, stats)]
+    assert.ok(stats.steps <= 4 * input.length + 8, `scanner step bound ${stats.steps}/${input.length}`)
+    assert.ok(found.length >= 1, 'slash adversary must exercise actual path-span matching')
+    assert.equal(linkifyFilePaths(input, noWrap), input, 'candidate must preserve adversarial content')
+  }
+  const failed = '/' + '.'.repeat(n) + 'x'
+  const failedStats = { inspected: 0 }
+  assert.equal(scanner.trailingPathPunctuationStart(failed, failedStats), failed.length)
+  assert.equal(failedStats.inspected, 1)
+  const validPath = './src/文件.ts'
+  const suffix = '!'.repeat(n)
+  const suffixStats = { inspected: 0 }
+  assert.equal(scanner.trailingPathPunctuationStart(validPath + suffix, suffixStats), validPath.length)
+  assert.equal(suffixStats.inspected, n + 1)
+  const out = linkifyFilePaths(validPath + suffix, (path, display) => createHyperlink(fileLinkUrl(path), display, { supportsHyperlinks: true, style: s => s }))
+  const targets = [...out.matchAll(/\x1b\]8;[^;]*;([^\x07\x1b]*)(?:\x07|\x1b\\)/g)].map(match => match[1]!).filter(Boolean)
+  assert.deepEqual(targets, [fileLinkUrl(validPath)])
+  assert.ok(out.endsWith(suffix), 'long punctuation suffix must remain visible')
+}
+console.log('PASS slash/punctuation operation, semantics, OSC8 and relative-speed checks')
diff --git a/scripts/verify-fold-back-user.ts b/scripts/verify-fold-back-user.ts
new file mode 100644
index 00000000..d4abdd01
--- /dev/null
+++ b/scripts/verify-fold-back-user.ts
@@ -0,0 +1,275 @@
+/** Focused regression for DSH user-row folding/restoration; no live session or credentials.
+ * Run: node --import tsx/esm scripts/verify-fold-back-user.ts
+ */
+import assert from 'node:assert/strict'
+import { tmpdir } from 'node:os'
+import { mkdirSync, mkdtempSync, realpathSync, rmSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import type { ChatRow } from '../src/dsh-adapter/channel/types.js'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+
+// Isolate even when this script is run directly, before production imports.
+const parent = realpathSync(tmpdir())
+const scratch = mkdtempSync(join(parent, 'dsh-fold-user-'))
+try {
+  for (const key of Object.keys(process.env)) {
+    if (key === 'HOME' || key === 'USERPROFILE' || key.startsWith('XDG_') || key.startsWith('DSH_') ||
+      /TOKEN|SECRET|CREDENTIAL|API_KEY|PASSWORD|ACCESS_KEY|^(HTTP|HTTPS|ALL|NO)_PROXY$/i.test(key)) delete process.env[key]
+  }
+  for (const dir of ['home', 'config', 'cache', 'data', 'state', 'dsh', 'tmp']) mkdirSync(join(scratch, dir))
+  Object.assign(process.env, {
+    HOME: join(scratch, 'home'), USERPROFILE: join(scratch, 'home'),
+    XDG_CONFIG_HOME: join(scratch, 'config'), XDG_CACHE_HOME: join(scratch, 'cache'),
+    XDG_DATA_HOME: join(scratch, 'data'), XDG_STATE_HOME: join(scratch, 'state'),
+    DSH_HOME: join(scratch, 'dsh'), DSH_TUI_HOME: join(scratch, 'dsh'),
+    TMPDIR: join(scratch, 'tmp'), TMP: join(scratch, 'tmp'), TEMP: join(scratch, 'tmp'), TSX_DISABLE_CACHE: '1',
+  })
+  const { foldBack, foldRows, restoreRowFromEvent } = await import('../src/dsh-adapter/channel/transcript.js')
+  const { createDshTranslator } = await import('../src/dsh-adapter/backend/translate.js')
+  const { createChannel } = await import('../src/dsh-adapter/channel.js')
+  const { mountChannelUi } = await import('../src/dsh-adapter/channel-ui.js')
+
+const user = (seq: number, content: unknown[], source: unknown = { kind: 'user' }): SessionEvent =>
+  ({ seq, time: seq, type: 'user/message', data: { id: `u${seq}`, source, content } }) as unknown as SessionEvent
+const text = (value: string) => ({ type: 'text', text: value })
+const assistant = (seq: number): SessionEvent =>
+  ({ seq, type: 'assistant/message', data: { message: { content: [text('assistant answer')] } } }) as unknown as SessionEvent
+const row = (id: number, seq: number | undefined, value: string): ChatRow =>
+  ({ id, kind: 'user', text: value, ...(seq === undefined ? {} : { seq }) })
+
+// This test is intentionally first: on the original implementation a later
+// assistant message clears folded/restored while the long text is only preview.
+{
+  const full = `first question ${'长'.repeat(260)} last sentence`
+  const rows = [row(101, 10, full)]
+  assert.equal(foldRows(rows, 0), 1)
+  const preview = rows[0]!.text
+  assert.notEqual(preview, full)
+  assert.equal(foldBack(rows, [user(10, [text(full)]), assistant(11)]), 1)
+  assert.equal(rows[0]!.id, 101)
+  assert.equal(rows[0]!.seq, 10)
+  assert.equal(rows[0]!.text, full, 'restored must mean full user text, not the preview')
+  assert.equal(rows[0]!.folded, false)
+  assert.equal(rows[0]!.restored, true)
+}
+
+// The unverified helper cannot bypass user source/preview checks or expose
+// later attachment blocks; only foldBack may restore a user row.
+{
+  const target = row(102, 10, 'folded preview')
+  restoreRowFromEvent(target, user(10, [text('prompt'), text('PRIVATE ATTACHMENT')]))
+  assert.equal(target.text, 'folded preview')
+}
+
+// Multiple users, short and long, first duplicate seq wins. Only the first
+// text block belongs in the bubble: later text can be @attachment contents.
+{
+  const long = 'AB'.repeat(180)
+  const rows = [row(1, 5, 'short'), row(2, 9, long), row(3, 12, 'alpha')]
+  foldRows(rows, 0)
+  const events = [
+    user(5, [text(' short ')]), assistant(6),
+    user(9, [text(`  ${long}  `), { type: 'image', data: 'attachment' }, text('private attachment body')]),
+    user(9, [text('duplicate must not win')]), assistant(10),
+    user(12, [{ type: 'image', data: 'attachment' }, text(' alpha '), text('attachment body')]), assistant(13),
+  ]
+  assert.equal(foldBack(rows, events), 3)
+  assert.deepEqual(rows.map(r => [r.id, r.seq, r.text, r.folded, r.restored]), [
+    [1, 5, 'short', false, true], [2, 9, long, false, true], [3, 12, 'alpha', false, true],
+  ])
+}
+
+// User indexing does not assume folded rows are sorted by seq.
+{
+  const rows = [row(50, 20, 'later'), row(51, 2, 'earlier')]
+  foldRows(rows, 0)
+  assert.equal(foldBack(rows, [user(2, [text('earlier')]), user(20, [text('later')])]), 2)
+  assert.deepEqual(rows.map(r => r.text), ['later', 'earlier'])
+}
+
+// No event, a user at the wrong seq, or only an assistant at the same seq
+// must never claim the truncated content has been restored.
+for (const events of [[], [user(8, [text('wrong')]), assistant(9)], [assistant(7)]]) {
+  const rows = [row(20, 7, 'Z'.repeat(300))]
+  foldRows(rows, 0)
+  const preview = rows[0]!.text
+  assert.equal(foldBack(rows, events), 0)
+  assert.equal(rows[0]!.text, preview)
+  assert.equal(rows[0]!.folded, true)
+  assert.notEqual(rows[0]!.restored, true)
+}
+{
+  const rows = [row(21, undefined, 'x'.repeat(300))]
+  foldRows(rows, 0)
+  assert.equal(foldBack(rows, [user(1, [text('wrong')]), assistant(2)]), 0)
+  assert.equal(rows[0]!.folded, true)
+}
+
+// Malformed historical payloads cannot prove a restoration and must not crash.
+for (const data of [null, {}, { source: { kind: 'user' }, content: null },
+  { source: { kind: 'user' }, content: [null] },
+  { source: { kind: 'user' }, content: [{ type: 'text', text: 42 }] },
+]) {
+  const rows = [row(22, 7, 'x'.repeat(300))]
+  foldRows(rows, 0)
+  const event = { seq: 7, type: 'user/message', data } as unknown as SessionEvent
+  assert.equal(foldBack(rows, [event, assistant(8)]), 0)
+  assert.equal(rows[0]!.folded, true)
+  assert.notEqual(rows[0]!.restored, true)
+}
+
+// A real image-only message has an empty projected body; folding never drops
+// the attachment. Empty textual blocks use the same first-text/trim semantics.
+{
+  const rows = [row(30, 4, '')]
+  const images = [{ id: 'image-1' }] as unknown as NonNullable<ChatRow['images']>
+  rows[0]!.images = images
+  foldRows(rows, 0)
+  assert.equal(foldBack(rows, [user(4, [{ type: 'image', data: 'attachment' }, text('  ')])]), 1)
+  assert.equal(rows[0]!.text, '')
+  assert.equal(rows[0]!.images, images)
+  assert.equal(rows[0]!.folded, false)
+  assert.equal(rows[0]!.restored, true)
+}
+
+// Compare against the real stateful translator: the first 0.2.0 teammate
+// prompt sheds its identity block, but a later ordinary prompt does not.
+{
+  const reminder = `<system-reminder>\nYou are teammate "alice".\nYour Team Lead is named "lead".\nUse list_agents({}) to find your teammates and their names.\nTo message your Team Lead, use send_message({ target: "lead", message: "..." }).\nTo message another teammate, use send_message({ target: "<teammate name>", message: "..." }).\n</system-reminder>\n\n`
+  const first = 'first human prompt ' + 'P'.repeat(260)
+  const second = 'second human prompt ' + 'Q'.repeat(260)
+  const events = [
+    user(1, [text(reminder), text(first), text('ATTACHMENT-CONTENT')]),
+    user(3, [text(second), text('SECRET-ATTACHMENT')]),
+    user(5, [text(reminder), text('later text is an attachment')]),
+  ]
+  const translator = createDshTranslator({ tools: () => undefined, scope: () => undefined, attachments: () => undefined })
+  const translated = events.flatMap(event => translator.translateEvent(event)).filter(event => event.type === 'user.message' && event.source === 'user')
+  assert.deepEqual(translated.map(event => event.text), [first, second, reminder.trim()])
+  const rows = translated.map((event, index) => row(100 + index, event.seq, event.text))
+  foldRows(rows, 0)
+  assert.equal(foldBack(rows, events), 3)
+  assert.deepEqual(rows.map(r => r.text), translated.map(event => event.text))
+  assert.ok(rows.every(r => r.restored === true && r.folded === false))
+
+  // Both the raw and legacy-stripped candidate have the same 200-character
+  // preview but different full content: guessing either would be unsafe.
+  const ambiguousRows = [row(200, 9, reminder.trim())]
+  foldRows(ambiguousRows, 0)
+  const before = ambiguousRows[0]!.text
+  assert.equal(foldBack(ambiguousRows, [user(9, [text(reminder), text(reminder + 'different tail')])]), 0)
+  assert.equal(ambiguousRows[0]!.text, before)
+  assert.equal(ambiguousRows[0]!.folded, true)
+  assert.notEqual(ambiguousRows[0]!.restored, true)
+}
+
+// Same-seq non-human sources and content which does not match the existing
+// preview are not evidence that a human bubble was reconstructed.
+for (const event of [
+  user(7, [text('X'.repeat(300))], { kind: 'plugin' }),
+  user(7, [text('X'.repeat(300))], { kind: 'agent-message', form: 'relay', senderSessionId: 'peer' }),
+  user(7, [text('different'.repeat(50))]),
+]) {
+  const rows = [row(40, 7, 'X'.repeat(300))]
+  foldRows(rows, 0)
+  const before = rows[0]!.text
+  assert.equal(foldBack(rows, [event, assistant(8)]), 0)
+  assert.equal(rows[0]!.text, before)
+  assert.equal(rows[0]!.folded, true)
+  assert.notEqual(rows[0]!.restored, true)
+}
+
+// Synthetic durable log through the real channel seed, emitter and UI mount.
+// One user round with 610 distinct assistant steps keeps the prompt in the
+// open chunk while exceeding the 600-row folding window.
+{
+  const full = 'mounted prompt ' + 'M'.repeat(300)
+  const events: SessionEvent[] = [user(1, [text(full), text('PRIVATE ATTACHMENT BODY')])]
+  for (let step = 1; step <= 610; step += 1) {
+    events.push({ seq: step + 1, time: step + 1, type: 'assistant/message', data: {
+      turn: 1, step, message: { content: [text(`answer ${step}`)] },
+    } } as unknown as SessionEvent)
+  }
+  const cleanups: Array<() => void> = []
+  const ctx = {
+    on: () => () => undefined,
+    effect: (setup: () => () => void) => { cleanups.push(setup()) },
+    get: () => undefined,
+    logger: { warn() {} },
+  }
+  const agent = {
+    id: 'synthetic-user-fold-agent', status: 'idle',
+    session: { id: 'synthetic-user-fold-session', seq: events.length, events },
+    ctx: { on: () => () => undefined },
+    followup() {}, steer() {}, cancel() {}, inbox: { remove: () => true },
+  }
+  const raw = createChannel(ctx as never, agent as never, { model: 'fixture', provider: 'fixture', cwd: scratch, activity: false })
+  const mounted = mountChannelUi(ctx, raw, undefined, 'new')
+  try {
+    await new Promise<void>((resolve, reject) => {
+      const timeout = setTimeout(() => { unsubscribe(); reject(new Error('channel did not publish folded user row')) }, 2000)
+      const unsubscribe = mounted.channel.subscribe(() => {
+        if (!mounted.channel.rows.some(r => r.kind === 'user' && r.seq === 1 && r.folded)) return
+        clearTimeout(timeout)
+        unsubscribe()
+        resolve()
+      })
+      raw.emitStream()
+    })
+    const before = mounted.channel.rows.find(r => r.kind === 'user' && r.seq === 1)
+    assert.ok(before, 'real seed projected the user prompt')
+    assert.ok(raw.rows.length > 600, 'real seed projected over 600 rows')
+    assert.equal(before.folded, true, 'real emitter folded the old user row')
+    assert.notEqual(before.text, full)
+    assert.ok(mounted.channel.loadOlder() > 0, 'real UI loadOlder restored rows')
+    const after = mounted.channel.rows.find(r => r.id === before.id)
+    assert.equal(after?.seq, 1)
+    assert.equal(after?.text, full)
+    assert.equal(after?.folded, false)
+    assert.equal(after?.restored, true)
+    assert.ok(!after?.text.includes('PRIVATE ATTACHMENT BODY'))
+  } finally {
+    mounted.dispose()
+    raw.releaseContributions()
+    for (const cleanup of cleanups.reverse()) cleanup()
+  }
+}
+
+// A real folded-user batch, separate from the assistant/tool click budget.
+// Timings are diagnostic (median of five), while counts and event traversal
+// are deterministic; no host-dependent wall-clock threshold is relaxed.
+{
+  const count = 10_000
+  const full = 'batch question ' + 'x'.repeat(280)
+  const durable = Array.from({ length: count }, (_, i) => user(i + 1, [text(full)]))
+  let traversed = 0
+  const events: readonly SessionEvent[] = new Proxy(durable, {
+    get(target, prop, receiver) {
+      if (prop === Symbol.iterator) return function* () {
+        for (const event of target) { traversed += 1; yield event }
+      }
+      return Reflect.get(target, prop, receiver)
+    },
+  })
+  const times: number[] = []
+  for (let run = 0; run < 5; run += 1) {
+    const rows = Array.from({ length: count }, (_, i) => row(i + 1, i + 1, full))
+    assert.equal(foldRows(rows, 0), count)
+    traversed = 0
+    const start = process.hrtime.bigint()
+    assert.equal(foldBack(rows, events), count)
+    times.push(Number(process.hrtime.bigint() - start) / 1e6)
+    assert.equal(traversed, count, 'events are traversed exactly once, not once per user row')
+    assert.ok(rows.every(r => r.text === full && r.restored === true && r.folded === false))
+  }
+  times.sort((a, b) => a - b)
+  console.log(`${count} real folded users: median ${times[2]!.toFixed(1)} ms / 5 runs`)
+}
+
+console.log('verify-fold-back-user OK')
+} finally {
+  // Remove only the exact private directory we just created, never a symlink
+  // replacement or a path outside the verified real temporary parent.
+  if (dirname(scratch) !== parent || realpathSync(scratch) !== scratch) throw new Error('refusing unsafe scratch cleanup')
+  rmSync(scratch, { recursive: true })
+}
diff --git a/scripts/verify-folded-code-summary.ts b/scripts/verify-folded-code-summary.ts
new file mode 100644
index 00000000..4dd97f7e
--- /dev/null
+++ b/scripts/verify-folded-code-summary.ts
@@ -0,0 +1,86 @@
+/**
+ * Folded fence summary equivalence and allocation regression.
+ * Run: node --expose-gc --import tsx/esm scripts/verify-folded-code-summary.ts
+ */
+import assert from 'node:assert/strict'
+import { summarizeFoldedCode } from '../src/components/Markdown.js'
+
+function original(text: string): { lineCount: number; preview: string } {
+  const lines = text.split('\n')
+  if (lines.at(-1) === '') lines.pop()
+  const lineCount = text === '' ? 0 : lines.length
+  for (const line of text.split('\n')) {
+    const trimmed = line.trim()
+    if (trimmed !== '') return { lineCount, preview: trimmed.length > 160 ? `${trimmed.slice(0, 160)}…` : trimmed }
+  }
+  return { lineCount, preview: '' }
+}
+
+const fixtures = [
+  '', '\n', '\n\n', 'a', 'a\n', 'a\n\n', '\r\n\r\n  x  \r\n',
+  '\u00a0\ufeff\u2028\u2029\n\t字😀  \r\nsecond', '\u0085\nnext',
+  '  ' + 'a'.repeat(159) + '  ', 'a'.repeat(160), 'a'.repeat(161),
+  'a'.repeat(159) + '😀' + '  \n', ' '.repeat(100_000) + '\n  tail  ',
+  ('x\n').repeat(200_000), '  ' + 'x'.repeat(1_000_000) + '  ',
+  'x' + ' '.repeat(1_000_000) + '\nnext',
+  ' '.repeat(4095) + '😀' + '\u2028\u2029\nnext',
+  '😀' + ' '.repeat(4095) + '\nsecond',
+  '\u2028'.repeat(4096) + '\u2029\r\n' + 'first' + '\nlast',
+  'x'.repeat(4095) + '😀' + ' '.repeat(4095),
+]
+for (const text of fixtures) assert.deepEqual(summarizeFoldedCode(text), original(text))
+
+// Check the trim classification of every UTF-16 code unit, not just examples.
+for (let code = 0; code <= 0xffff; code++) {
+  const unit = String.fromCharCode(code)
+  for (const text of [unit + 'x', 'x' + unit, unit + '\n' + 'x']) {
+    assert.deepEqual(summarizeFoldedCode(text), original(text), `UTF-16 unit ${code.toString(16)}`)
+  }
+}
+
+// Deterministic differential fuzz includes lone surrogates and every trim whitespace.
+let seed = 0x12345678
+const units = ['a', ' ', '\n', '\r', '\t', '\v', '\f', '\u00a0', '\u1680', '\u2000', '\u200a', '\u2028', '\u2029', '\u202f', '\u205f', '\u3000', '\ufeff', '\u0085', '\ud83d', '\ude00', '中']
+for (let trial = 0; trial < 10_000; trial++) {
+  seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0
+  const length = seed % 300
+  let text = ''
+  for (let i = 0; i < length; i++) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0
+    text += units[seed % units.length]
+  }
+  assert.deepEqual(summarizeFoldedCode(text), original(text), `trial ${trial}`)
+}
+
+assert.ok(global.gc, 'run with --expose-gc')
+// Input is flattened before measuring; only generation allocation is measured.
+const large = ('line contents for summary\n').repeat(200_000)
+large.charCodeAt(large.length - 1)
+global.gc()
+const beforeGeneration = process.memoryUsage().heapUsed
+const result = summarizeFoldedCode(large)
+const generationDelta = process.memoryUsage().heapUsed - beforeGeneration
+assert.deepEqual(result, { lineCount: 200_000, preview: 'line contents for summary' })
+assert.ok(generationDelta < 4 * 1024 * 1024, `generation allocated ${generationDelta} bytes`)
+
+// Keep only summaries, not the synthetic input strings; a substring backed by
+// even one full input would retain megabytes after GC. Each input is unique.
+global.gc()
+const beforeRetention = process.memoryUsage().heapUsed
+function makeSummaries(): Array<{ lineCount: number; preview: string }> {
+  const summaries: Array<{ lineCount: number; preview: string }> = []
+  for (let i = 0; i < 12; i++) {
+    const text = `${String(i).padStart(3, '0')}${'x'.repeat(3_000_000)}\n`
+    summaries.push(summarizeFoldedCode(text))
+  }
+  return summaries
+}
+const summaries = makeSummaries()
+// Let V8 clear transient stack roots from the producer before measuring.
+await new Promise<void>(resolve => setImmediate(resolve))
+global.gc()
+const retainedDelta = process.memoryUsage().heapUsed - beforeRetention
+assert.equal(summaries.length, 12)
+assert.ok(summaries.every((value, i) => value.lineCount === 1 && value.preview === `${String(i).padStart(3, '0')}${'x'.repeat(157)}…`))
+assert.ok(retainedDelta < 2 * 1024 * 1024, `summaries retained ${retainedDelta} bytes`)
+console.log(`folded summary: ${fixtures.length} fixtures + 65536 UTF-16 units x 3 + 10000 differential cases; generation delta ${generationDelta} bytes, retained delta ${retainedDelta} bytes`)
diff --git a/scripts/verify-history-chunks.ts b/scripts/verify-history-chunks.ts
new file mode 100644
index 00000000..696fa346
--- /dev/null
+++ b/scripts/verify-history-chunks.ts
@@ -0,0 +1,227 @@
+/**
+ * Chunked history: the cut plan, the collapsed section row, and the id range a
+ * load-on-sight / rail reveal depends on (`ChannelUi.revealRow`, implemented by
+ * the DSH extension's `revealChunkRow`).
+ *
+ * The regressions this guards: (1) a reveal used to expand the WHOLE record
+ * (`showAllMessages`, a 27,907-row relayout, 5.6 GB RSS before the process was
+ * killed) — it must project only the owning chunk; (2) a collapsed chunk used
+ * to fake one prompt row per human prompt, which made the transcript read as if
+ * every old turn were missing its answer — a collapsed chunk is now exactly one
+ * section line and nothing else.
+ */
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import type { AgentEvent, AgentEventOf } from '../src/agent/events.js'
+import {
+  CHUNK_CHARS,
+  CHUNK_ROUNDS,
+  OPEN_ROUNDS,
+  chunkForRow,
+  placeholderRows,
+  planChunks,
+  type HistoryChunk,
+} from '../src/dsh-adapter/backend/history-chunks.js'
+import { projectHistorySlice } from '../src/channel/history-restore.js'
+
+const digest = (chunk: HistoryChunk): string => `⏸ rounds ${chunk.fromRound}–${chunk.toRound}`
+
+const prompt = (seq: number, text: string, source: AgentEventOf<'user.message'>['source'] = 'user'): AgentEventOf<'user.message'> => ({
+  type: 'user.message',
+  id: `m${seq}`,
+  anchor: String(seq),
+  seq,
+  time: seq,
+  source,
+  text,
+  blocks: [],
+})
+const answer = (seq: number, text: string): AgentEvent => ({
+  type: 'assistant.message',
+  seq,
+  anchor: String(seq),
+  attemptId: `a${seq}`,
+  time: seq,
+  blocks: [{ type: 'text', text }],
+  canonical: true,
+})
+const toolCall = (seq: number, turn: number, step: number): AgentEvent => ({
+  type: 'tool.call',
+  seq,
+  turn,
+  step,
+  callId: `c${seq}`,
+  name: 'read_file',
+  argsJson: '{"path":"src/index.ts"}',
+  time: seq,
+})
+
+// ── the cut plan ──────────────────────────────────────────────────────────
+assert.deepEqual(planChunks([]), [], 'an empty record plans no chunk')
+
+const noPrompt: AgentEvent[] = [toolCall(0, 1, 1), toolCall(1, 1, 1)]
+const lone = planChunks(noPrompt)
+assert.equal(lone.length, 1, 'a record with no user message is one chunk')
+assert.deepEqual([lone[0]!.start, lone[0]!.end, lone[0]!.rounds], [0, 2, 0])
+
+// 120 rounds with invisible user messages mixed in: every user message opens a
+// round, but only prompts and team messages paint a placeholder row.
+const entries: AgentEvent[] = []
+const prompts: AgentEvent[] = []
+let seq = 0
+for (let round = 0; round < 120; round += 1) {
+  const text = `round ${round} ${'x'.repeat(80)}`
+  const event = prompt(seq, text, round % 10 === 3 ? 'team-message' : 'user')
+  entries.push(event)
+  prompts.push(event)
+  seq += 1
+  entries.push(answer(seq, `answer ${round} ${'y'.repeat(80)}`))
+  seq += 1
+  // A goal continuation starts a round (so a long goal run still cuts) but is
+  // represented by the digest line alone.
+  entries.push(prompt(seq, '', 'injected'))
+  seq += 1
+}
+
+const chunks = planChunks(entries)
+assert.ok(chunks.length >= 2, 'a long record is cut into several chunks')
+for (let index = 0; index < chunks.length; index += 1) {
+  const chunk = chunks[index]!
+  assert.equal(chunk.index, index, 'chunk indices are conversation-ordered')
+  assert.equal(chunk.start, index === 0 ? 0 : chunks[index - 1]!.end, 'chunks cover the record contiguously')
+  assert.equal(entries[chunk.start]!.type, 'user.message', 'a chunk starts at a round')
+  assert.ok(chunk.idBase < 0, 'chunk ids sit below every live row')
+  assert.equal(chunk.idBase, -(chunks.length - index) * 1_000_000, 'one id stride per chunk, ordered by index')
+  assert.ok(chunk.rounds >= 1 && chunk.rounds <= CHUNK_ROUNDS, 'older chunks stay inside the older budget')
+}
+assert.equal(chunks.at(-1)!.end, entries.length, 'the newest chunk closes the record')
+assert.ok(chunks.at(-1)!.rounds <= OPEN_ROUNDS, 'the newest chunk is the small open budget')
+// Deterministic for this record: 240 rounds (a prompt and a goal continuation
+// each open one) cut as newest 10, then 50 + 50 + 50 + 50, then the oldest 30.
+assert.equal(chunks.length, 6, '240 rounds cut at the older budget make six chunks')
+
+// ── the digest line's numbers ─────────────────────────────────────────────
+// A collapsed chunk reports events / tool calls / errors / weight and nothing
+// else, so those four must be right: an off-by-one there is a claim the reader
+// has no way to check.
+const weight = (event: AgentEvent): number => {
+  switch (event.type) {
+    case 'user.message':
+      return event.text.length
+    case 'assistant.message':
+      return event.blocks.reduce((sum, block) => sum + (block.text?.length ?? 0), 0)
+    case 'tool.call':
+      return event.argsJson.length
+    case 'tool.result':
+      return event.text.length
+    default:
+      return 0
+  }
+}
+for (const chunk of chunks) {
+  const range = entries.slice(chunk.start, chunk.end)
+  assert.equal(chunk.events, range.length, 'the digest reports its entry count')
+  assert.equal(chunk.toolCalls, range.filter(event => event.type === 'tool.call').length, 'and its tool calls')
+  assert.equal(chunk.errors, range.filter(event => event.type === 'tool.result' && event.isError === true).length, 'and its failures')
+  assert.equal(chunk.chars, range.reduce((sum, event) => sum + weight(event), 0), 'and its text weight')
+}
+
+// A round heavier than a whole page still lands alone: a round is taken whole
+// or not at all, because a result without its call surfaces as a stray row.
+let hugeSeq = 10_000
+const huge: AgentEvent[] = []
+for (const [text, size] of [['before', 10], ['huge', CHUNK_CHARS + 1], ['after', 10]] as const) {
+  huge.push(prompt(hugeSeq, text))
+  huge.push(answer(hugeSeq + 1, 'x'.repeat(size)))
+  hugeSeq += 2
+}
+const hugeChunks = planChunks(huge)
+assert.equal(hugeChunks.length, 3, 'an oversized round is not merged with its neighbours')
+const oversized = hugeChunks.find(chunk => chunk.chars > CHUNK_CHARS)
+assert.deepEqual(
+  [oversized?.rounds, oversized?.events],
+  [1, 2],
+  'the oversized round lands alone with both its entries',
+)
+assert.ok(hugeChunks.every((chunk, index) => chunk.start === (index === 0 ? 0 : hugeChunks[index - 1]!.end)), 'and the tiling still holds')
+
+// ── collapsed rows ────────────────────────────────────────────────────────
+// One row per unloaded chunk: the section line, flagged so the transcript
+// projects the chunk on sight. No prompt stand-ins and no projected content —
+// a collapsed chunk must never look like a conversation whose answers are gone.
+for (const chunk of chunks) {
+  const rows = placeholderRows(chunk, digest, entries)
+  assert.equal(rows.length, 1, 'an unloaded chunk contributes exactly one row')
+  const row = rows[0]!
+  assert.equal(row.id, chunk.idBase, 'the section line owns idBase')
+  assert.equal(row.kind, 'notice', 'a collapsed chunk is text only')
+  assert.equal(row.text, digest(chunk), 'the section line names its rounds')
+  assert.equal(row.collapsed, true, 'and is flagged as load-on-sight')
+  assert.equal(row.restored, true, 'and is exempt from the fold pass')
+  assert.equal(row.seq, undefined, 'a section line carries no seq (no rewind anchor)')
+  assert.equal(row.anchor, undefined, 'and no anchor: the log anchor arrives with the load')
+}
+
+// The bug this replaced: a collapsed chunk must not claim to be user rows.
+for (const chunk of chunks) {
+  assert.deepEqual(
+    placeholderRows(chunk, digest, entries).filter(row => row.kind === 'user'),
+    [],
+    'no prompt stand-in rows remain in the collapsed form',
+  )
+}
+
+// ── navigation is complete without painting fake prompt rows ─────────────
+const indexed = chunks.flatMap(chunk => placeholderRows(chunk, digest, entries)[0]!.collapsedTurns ?? [])
+const humanRows = projectHistorySlice(entries, 'preview').filter(row => row.kind === 'user' && row.label !== 'team-message')
+assert.deepEqual(indexed.map(turn => turn.seq), humanRows.map(row => row.seq), 'the index covers every real human prompt in record order')
+assert.equal(new Set(indexed.map(turn => turn.id)).size, indexed.length, 'handles are unique across all chunks')
+assert.ok(indexed.every(turn => turn.id < chunks[0]!.idBase), 'virtual handles never collide with real chunk or live rows')
+assert.ok(indexed.every(turn => chunkForRow(chunks, turn.id) === undefined), 'a virtual handle cannot accidentally reveal another chunk')
+for (const chunk of chunks) {
+  const meta = placeholderRows(chunk, digest, entries)[0]!.collapsedTurns ?? []
+  const real = projectHistorySlice(entries.slice(chunk.start, chunk.end), 'preview')
+  for (const turn of meta) {
+    const row = real.find(row => row.kind === 'user' && row.label !== 'team-message' && row.seq === turn.seq)
+    assert.equal(row?.text, turn.text, 'every handle resolves to the exact projected prompt by seq')
+  }
+}
+// Empty inputs and background sources do not create human ticks. Whitespace
+// and image-only human prompts DO, exactly like the shared projector.
+const edgeEntries: AgentEvent[] = [
+  prompt(20_000, ''),
+  prompt(20_001, '   '),
+  { ...prompt(20_002, ''), images: [{ id: 'image', width: 1, height: 1, read: async () => new Uint8Array() }] },
+  prompt(20_003, 'peer', 'team-message'),
+  prompt(20_004, 'goal', 'injected'),
+  prompt(20_005, 'checkpoint', 'compaction'),
+  prompt(20_006, 'command output', 'command-output'),
+]
+const edgeChunk = planChunks(edgeEntries)[0]!
+const edgeIndex = placeholderRows(edgeChunk, digest, edgeEntries)[0]!.collapsedTurns!
+assert.deepEqual(edgeIndex.map(turn => turn.seq), [20_001, 20_002], 'the index uses the projector visibility/source predicate')
+assert.deepEqual(edgeIndex.map(turn => turn.imageCount), [0, 1], 'image-only prompts retain their preview count')
+
+// ── which chunk owns a row ────────────────────────────────────────────────
+for (const chunk of chunks) {
+  assert.equal(chunkForRow(chunks, chunk.idBase), chunk, 'a chunk owns its section line')
+  assert.equal(chunkForRow(chunks, chunk.idBase + 1), chunk, 'and the ids its loaded rows will take')
+  assert.equal(chunkForRow(chunks, chunk.idBase + 999_999), chunk, 'up to its whole id stride')
+}
+assert.equal(chunkForRow(chunks, 0), undefined, 'live rows belong to no chunk')
+assert.equal(chunkForRow(chunks, 27_907), undefined, 'live row ids are never in a chunk range')
+
+// ── load-on-sight target ──────────────────────────────────────────────────
+// The section line's id is the reveal handle: it survives materialization
+// (`chunkRows` also starts at idBase), so the transcript can project the chunk
+// and keep the reader anchored on the same line. A loaded chunk's projected
+// rows must cover real answers, which is what makes the load worth doing.
+const oldest = chunks[0]!
+const projected = projectHistorySlice(entries.slice(oldest.start, oldest.end), 'preview')
+assert.ok(projected.some(row => row.kind === 'assistant'), 'a loaded chunk contains model output')
+assert.ok(projected.some(row => row.kind === 'user'), 'and the prompts it answered')
+assert.ok(projected.every(row => row.id >= 0), 'projection assigns live ids; the chunk re-bases them off idBase')
+for (let index = 0; index < projected.length; index += 1) {
+  const id = oldest.idBase + 1 + index
+  assert.ok(id < oldest.idBase + 1_000_000, 'every loaded row stays inside the chunk id stride')
+}
diff --git a/scripts/verify-history-prose-default.tsx b/scripts/verify-history-prose-default.tsx
new file mode 100644
index 00000000..ae692bf4
--- /dev/null
+++ b/scripts/verify-history-prose-default.tsx
@@ -0,0 +1,248 @@
+/**
+ * Default historical prose through synthetic DSH events -> createChannel ->
+ * mountChannelUi -> fullscreen Chat -> headless xterm. No real session or
+ * credentials; HOME and DSH/XDG homes are temporary. No reveal, hover, rail
+ * click or Ctrl+O: only normal PageUp/End and wheel scrolling. Before rendering and again
+ * before input, check real transcript rows, never collapsedTurns metadata.
+ * Twelve turns each have a prompt and ten answer lines (>120 logical lines);
+ * this does NOT exercise MessageList's separate 120 projected-row cap. Large
+ * tool arguments force old chunks without flooding the visible viewport.
+ * Run: node --import tsx/esm scripts/verify-history-prose-default.tsx
+ */
+import assert from 'node:assert/strict'
+import { closeSync, mkdtempSync, mkdirSync, openSync, realpathSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { basename, dirname, join } from 'node:path'
+import { PassThrough, Writable } from 'node:stream'
+
+const tempRoot = realpathSync(tmpdir())
+const scratch = mkdtempSync(join(tempRoot, 'dsh-history-prose-'))
+const envKeys = ['HOME', 'USERPROFILE', 'XDG_CONFIG_HOME', 'XDG_CACHE_HOME', 'XDG_DATA_HOME', 'XDG_STATE_HOME', 'FORCE_COLOR']
+const previous = new Map([...Object.entries(process.env).filter(([key]) => key.startsWith('DSH_')), ...envKeys.map(key => [key, process.env[key]] as const)])
+for (const key of Object.keys(process.env)) if (key.startsWith('DSH_')) delete process.env[key]
+process.env.HOME = join(scratch, 'home')
+process.env.USERPROFILE = process.env.HOME
+process.env.DSH_HOME = join(scratch, 'dsh-home')
+process.env.XDG_CONFIG_HOME = join(scratch, 'config')
+process.env.XDG_CACHE_HOME = join(scratch, 'cache')
+process.env.XDG_DATA_HOME = join(scratch, 'data')
+process.env.XDG_STATE_HOME = join(scratch, 'state')
+process.env.FORCE_COLOR = '3'
+process.env.DSH_TUI_THEME = 'dark'
+process.env.DSH_TUI_LANG = 'zh'
+mkdirSync(process.env.HOME, { recursive: true })
+let ttyFd: number | undefined
+
+try {
+  ttyFd = openSync(join(scratch, 'tty-output'), 'w')
+  const [React, { Terminal }, { render, AlternateScreen }, { Chat }, { QuestionStore }, { createChannel }, { mountChannelUi }, { registerTuiChannel }, { bindChannelCommands }, { settled, sleep }, { default: inkInstances }, { createDshTranslator }, { planChunks }] = await Promise.all([
+    import('react'), import('@xterm/headless'), import('../src/ui.js'), import('../src/screens/Chat.js'),
+    import('../src/dsh-adapter/questions.js'), import('../src/dsh-adapter/channel.js'),
+    import('../src/dsh-adapter/channel-ui.js'), import('../src/adapter/channel/host-registry.js'),
+    import('../src/dsh-adapter/channel/commands.js'), import('./lib/term-test.mjs'), import('../src/ink/instances.js'),
+    import('../src/dsh-adapter/backend/translate.js'), import('../src/dsh-adapter/backend/history-chunks.js'),
+  ])
+  type RawEvent = { type: string; seq: number; time: number; data: Record<string, unknown> }
+  const events: RawEvent[] = []
+  const append = (type: string, data: Record<string, unknown>): void => {
+    events.push({ type, seq: events.length + 1, time: events.length + 1, data })
+  }
+  const prompt = (n: number) => `PROSE-PROMPT-${n}-complete question`
+  const answerLine = (n: number, line: number) => `PROSE-ANSWER-${n}-line-${String(line).padStart(2, '0')}-complete`
+  const answer = (n: number) => Array.from({ length: 10 }, (_, i) => answerLine(n, i + 1)).join('\n')
+  for (let n = 1; n <= 12; n += 1) {
+    append('user/message', { id: `user-${n}`, source: { kind: 'user' }, content: [{ type: 'text', text: prompt(n) }] })
+    if (n < 12) append('tool/call', { turn: n, step: 1, callId: `large-${n}`, name: 'ask_user_question', arguments: JSON.stringify({ unused: 'x'.repeat(300_000) }) })
+    append('assistant/message', { turn: n, step: 1, message: { role: 'assistant', content: [{ type: 'text', text: answer(n) }] } })
+  }
+  const callbacks = new Map<string, Set<(...args: unknown[]) => unknown>>()
+  const cleanups: (() => void)[] = []
+  const agent = { id: 'history-prose', status: 'idle', session: { id: 'synthetic-session', seq: events.length, events, header: { cwd: scratch } }, ctx: { on: () => () => undefined }, followup() {}, steer() {}, cancel() {}, inbox: { remove: () => true } }
+  const services: Record<string, unknown> = {
+    settings: { describe: () => [{ ns: 'llm-pi-ai', revision: 1, user: {}, value: {} }, { ns: 'dsh-tui', revision: 1, user: {}, value: { recapOnOpen: false } }], get: () => ({}), mutate: async () => undefined },
+    credentials: { resolve: async () => undefined, set: async () => undefined, unset: async () => undefined },
+    llm: { listConfigurableProviders: () => [], discoverModels: async () => [] },
+  }
+  const ctx = {
+    on(name: string, listener: (...args: unknown[]) => unknown) { const set = callbacks.get(name) ?? new Set(); set.add(listener); callbacks.set(name, set); return () => { set.delete(listener) } },
+    effect(setup: () => () => void) { cleanups.push(setup()) },
+    get(name: string) { return services[name] }, logger: { warn() {} },
+  }
+  const raw = createChannel(ctx as never, agent as never, { model: 'model', provider: 'provider', cwd: scratch, activity: false, whale: false, whaleIdle: false, minimalUi: true, smoothStreaming: false })
+  const unregister = registerTuiChannel(ctx, raw)
+  const mount = mountChannelUi(ctx, raw, undefined, 'new')
+  bindChannelCommands(raw, mount.channel)
+  const COLS = 100
+  const ROWS = 40
+  const term = new Terminal({ cols: COLS, rows: ROWS, scrollback: 0, allowProposedApi: true })
+  let pendingFrames = 0
+  let parsedFrames = 0
+  let observeFrame: () => void = () => undefined
+  class FakeStdout extends Writable {
+    columns = COLS
+    rows = ROWS
+    isTTY = true
+    fd = ttyFd
+    _write(chunk: unknown, _encoding: BufferEncoding, done: () => void) {
+      pendingFrames += 1
+      term.write(String(chunk), () => { pendingFrames -= 1; parsedFrames += 1; observeFrame(); done() })
+    }
+  }
+  class FakeStdin extends PassThrough { isTTY = true; setRawMode() { return this }; ref() { return this }; unref() { return this } }
+  const stdout = new FakeStdout()
+  const stdin = new FakeStdin()
+  const stderr = Object.assign(new Writable({ write(_chunk, _encoding, done) { done() } }), { isTTY: true })
+  const screen = (): string[] => Array.from({ length: ROWS }, (_, i) => term.buffer.active.getLine(term.buffer.active.baseY + i)?.translateToString(true) ?? '')
+  type ProbeNode = { childNodes?: ProbeNode[]; scrollTop?: number; scrollHeight?: number; scrollViewportHeight?: number; scrollViewportTop?: number }
+  const scrollNode = (): ProbeNode | undefined => {
+    const root = (inkInstances.get(stdout as never) as unknown as { rootNode?: ProbeNode } | undefined)?.rootNode
+    const walk = (node: ProbeNode): ProbeNode | undefined => {
+      if (node.scrollViewportHeight !== undefined) return node
+      for (const child of node.childNodes ?? []) { const found = walk(child); if (found) return found }
+      return undefined
+    }
+    return root && walk(root)
+  }
+  let passed = 0
+  let failed = 0
+  const check = (name: string, ok: boolean): void => {
+    if (ok) { passed += 1; console.log(`PASS: ${name}`) }
+    else { failed += 1; console.error(`FAIL: ${name}`) }
+  }
+  const targets = [1, 6, 11, 12]
+  // Default window = the newest chunk (OPEN_ROUNDS/OPEN_CHARS in
+  // docs/dynamic-history-loading.md): its turns must be present as full prompt
+  // + full answer rows; older turns must be either equally full (already
+  // materialized) or covered by a collapsed digest row — never silently
+  // missing. Every round here carries ~300 KB of tool arguments, so the char
+  // budget (not the round count) decides the window; take it from the plan.
+  let openWindow: [number, number] = [1, 0]
+  const checkRows = (stage: string): void => {
+    const rows = mount.channel.rows
+    for (const n of targets) {
+      const userIndex = rows.findIndex(row => row.kind === 'user' && row.text === prompt(n))
+      const answerIndex = rows.findIndex(row => row.kind === 'assistant' && row.text === answer(n))
+      const full = userIndex >= 0 && answerIndex > userIndex
+      if (n >= openWindow[0] && n <= openWindow[1]) {
+        check(`${stage}: turn ${n} has full prompt then full answer in transcript rows`, full)
+        continue
+      }
+      const digest = rows.findIndex(row => row.collapsed === true && (row.collapsedTurns ?? []).some(turn => turn.text === prompt(n)))
+      check(`${stage}: older turn ${n} is loaded in full or behind a collapsed digest row`, full || digest >= 0)
+    }
+  }
+  let app: Awaited<ReturnType<typeof render>> | undefined
+  try {
+    check('fixture contains >120 logical prompt/answer lines', 12 * 11 > 120)
+    const translator = createDshTranslator({ tools: () => undefined, scope: () => undefined, attachments: () => undefined })
+    const chunks = planChunks(translator.translateReplay(events as never, { present: false }))
+    check('translated fixture plans multiple old chunks', chunks.length >= 3)
+    const newest = chunks[chunks.length - 1]!
+    openWindow = [newest.fromRound, newest.toRound]
+    check('the newest chunk opens a real window of rounds', newest.fromRound >= 1 && newest.toRound >= newest.fromRound)
+    checkRows('before render, before interaction')
+    app = await render(<AlternateScreen><Chat channel={mount.channel} questionStore={new QuestionStore()} fullscreen trajectorySeen /></AlternateScreen>, { stdout: stdout as never, stdin: stdin as never, stderr: stderr as never, patchConsole: false, exitOnCtrlC: false })
+    check('initial xterm screen and scrolling viewport are ready', await settled(() => scrollNode() !== undefined && screen().some(line => line.trim() !== ''), { timeoutMs: 20000 }))
+    checkRows('after render, before interaction')
+    const rowPairs = (): number[] => targets.filter(n => {
+      const rows = mount.channel.rows
+      const userIndex = rows.findIndex(row => row.kind === 'user' && row.text === prompt(n))
+      return userIndex >= 0 && rows.findIndex(row => row.kind === 'assistant' && row.text === answer(n)) > userIndex
+    })
+    const preInput = rowPairs()
+    console.log(`PRE_INPUT transcript_pairs=${preInput.join(',')}`)
+    const found = new Set<number>()
+    const foundAfterInput = new Set<number>()
+    const firstMaterialized = new Map<number, string>()
+    let navigation = 'End'
+    const capture = (): void => {
+      for (const n of rowPairs()) if (!preInput.includes(n) && !firstMaterialized.has(n)) firstMaterialized.set(n, navigation)
+      const lines = screen()
+      for (const n of targets) {
+        const indexes = [prompt(n), ...Array.from({ length: 10 }, (_, i) => answerLine(n, i + 1))].map(text => lines.findIndex(line => line.includes(text)))
+        if (indexes.every((index, i) => index >= 0 && (i === 0 || index > indexes[i - 1]!))) {
+          found.add(n)
+          if (!preInput.includes(n)) foundAfterInput.add(n)
+        }
+      }
+    }
+    // Each callback follows xterm's asynchronous parse of a complete stdout
+    // write. Retain successful actual frames, not just the last frame after a
+    // chunk has materialized and potentially moved the viewport again.
+    observeFrame = capture
+    // End is ordinary scrolling, not a reveal: start at the actual tail.
+    stdin.write('\x1b[F')
+    check('End reaches newest prompt before the upward walk', await settled(() => screen().some(line => line.includes(prompt(12)))))
+    await settled(() => screen().some(line => line.includes(answerLine(12, 10))) && pendingFrames === 0, { timeoutMs: 1500 })
+    capture()
+    let moves = 0
+    navigation = 'PageUp'
+    const pageStart = scrollNode()?.scrollTop
+    const pageFrame = parsedFrames
+    stdin.write('\x1b[5~')
+    const pageMoved = await settled(() => pageStart !== undefined && (scrollNode()?.scrollTop ?? pageStart) < pageStart, { timeoutMs: 3000, stepMs: 5 })
+    const pageParsed = await settled(() => parsedFrames > pageFrame, { timeoutMs: 3000, stepMs: 5 })
+    if (pageMoved && pageParsed) moves += 1
+    console.log(`PAGE_UP start=${pageStart} observedUp=${pageMoved} parsedFrame=${pageParsed} top=${scrollNode()?.scrollTop}`)
+    // 固定窗:墙钟 MessageList load-on-sight waits 120ms after a section
+    // enters view; allow that production timer and the resulting frame to land.
+    await sleep(180)
+    await settled(() => pendingFrames === 0 && stdout.writableLength === 0)
+    capture()
+    // PageUp through the oldest reachable position; then wheel downward in
+    // three-line steps, so a full short turn cannot be skipped by paging.
+    for (let i = 0; i < 30; i += 1) {
+      const before = scrollNode()?.scrollTop
+      if (before === undefined || before <= 0) break
+      const frames = parsedFrames
+      stdin.write('\x1b[5~')
+      const moved = await settled(() => (scrollNode()?.scrollTop ?? before) < before, { timeoutMs: 1000, stepMs: 5 })
+      if (moved && await settled(() => parsedFrames > frames, { timeoutMs: 1000, stepMs: 5 })) moves += 1
+      await sleep(180) // 固定窗:墙钟 allow the production load-on-sight debounce to settle
+      await settled(() => pendingFrames === 0 && stdout.writableLength === 0)
+      capture()
+      if (!moved) break
+    }
+    navigation = 'wheel-down'
+    let wheelMoves = 0
+    for (let i = 0; i < 180 && !targets.every(n => found.has(n)); i += 1) {
+      const node = scrollNode()
+      const before = node?.scrollTop
+      if (before === undefined || node?.scrollViewportHeight === undefined || node.scrollViewportTop === undefined) break
+      const max = Math.max(0, (node.scrollHeight ?? 0) - node.scrollViewportHeight)
+      if (before >= max) break
+      const y = Math.max(1, Math.min(ROWS, node.scrollViewportTop + Math.floor(node.scrollViewportHeight / 2) + 1))
+      const frames = parsedFrames
+      stdin.write(`\x1b[<65;50;${y}M`)
+      const moved = await settled(() => (scrollNode()?.scrollTop ?? before) > before, { timeoutMs: 1000, stepMs: 5 })
+      if (moved && await settled(() => parsedFrames > frames, { timeoutMs: 1000, stepMs: 5 })) { moves += 1; wheelMoves += 1 }
+      await sleep(180) // 固定窗:墙钟 allow the production load-on-sight debounce to settle
+      await settled(() => pendingFrames === 0 && stdout.writableLength === 0)
+      capture()
+      if (!moved) break
+    }
+    observeFrame = () => undefined
+    console.log(`SCROLL moves=${moves} wheelMoves=${wheelMoves} finalTop=${scrollNode()?.scrollTop} found=${[...found].join(',')} post_input_materialized=${JSON.stringify(Object.fromEntries(firstMaterialized))} screen_after_input_only=${[...foundAfterInput].join(',')}`)
+    check('ordinary upward scrolling changes the viewport', pageMoved && pageParsed)
+    for (const n of targets) check(`ordinary scrolling paints full turn ${n} in correct screen order`, found.has(n))
+    if (failed) console.error(`FINAL SCREEN:\n${screen().join('\n')}`)
+    console.log(`HISTORY PROSE ${failed ? 'FAILED' : 'OK'} (${passed} passed, ${failed} failed)`)
+  } finally {
+    if (app) await app.unmount()
+    mount.dispose()
+    unregister()
+    raw.releaseContributions()
+    for (const cleanup of cleanups.reverse()) cleanup()
+    term.dispose()
+  }
+  if (failed) process.exitCode = 1
+} finally {
+  if (ttyFd !== undefined) closeSync(ttyFd)
+  for (const key of Object.keys(process.env)) if (key.startsWith('DSH_')) delete process.env[key]
+  for (const [key, value] of previous) { if (value === undefined) delete process.env[key]; else process.env[key] = value }
+  const actual = realpathSync(scratch)
+  assert.equal(dirname(actual), tempRoot, 'refuse cleanup outside real temporary root')
+  assert.ok(basename(actual).startsWith('dsh-history-prose-'), 'refuse cleanup of unowned path')
+  assert.equal(actual, scratch, 'refuse cleanup of replaced or redirected path')
+  rmSync(actual, { recursive: true, force: true })
+}
