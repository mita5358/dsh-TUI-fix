+  for (let row = 0; row < ROWS; row += 1) {
+    const line = buffer.getLine(buffer.baseY + row)
+    const glyphs = (line?.getCell(COLS - 2)?.getChars() ?? '') + (line?.getCell(COLS - 1)?.getChars() ?? '')
