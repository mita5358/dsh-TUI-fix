+    const { sub, reads } = sample(status)
+    const term = new Terminal({ cols: COLS, rows: ROWS, scrollback: 0, allowProposedApi: true })
+    const fd = openSync(join(scratch, `${surface}-${status}.reset`), 'wx', 0o600)
