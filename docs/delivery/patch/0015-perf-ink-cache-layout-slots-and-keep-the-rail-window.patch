+  process.on('SIGTERM', onSigterm)
+  const timer = setTimeout(() => stop('timeout'), 90000)
+  const limit = 1024 * 1024
+  const streams = {
+    stdout: { chunks: [], observed: 0, stored: 0, overflow: false },
+    stderr: { chunks: [], observed: 0, stored: 0, overflow: false },
+  }
