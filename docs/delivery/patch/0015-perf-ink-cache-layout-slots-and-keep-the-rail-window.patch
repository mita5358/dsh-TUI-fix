+const TIMEOUT_MS = 45_000, GRACE_MS = 2_000, LIMIT = 200_000
+let stopCurrent = null, interrupted = null
+for (const signal of ['SIGINT', 'SIGTERM']) process.on(signal, () => { interrupted ??= signal; stopCurrent?.(`parent-${signal}`) })
