+    prompt: sample.prompt,
+    attempts: sample.attempts,
+    rowsBefore: sample.rowsBefore,
+    summariesBefore: sample.summariesBefore,
+    revealSyncMs: Math.round(sample.revealSyncMs * 100) / 100,
