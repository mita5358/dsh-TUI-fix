+  getPendingDelta: () => 0,
+  getScrollHeight: () => CONTENT,
+  getFreshScrollHeight: () => CONTENT,
+  getViewportHeight: () => VIEWPORT,
+  getViewportTop: () => 0,
+  isSticky: () => false,
