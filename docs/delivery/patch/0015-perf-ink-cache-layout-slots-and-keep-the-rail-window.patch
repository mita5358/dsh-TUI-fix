+  scrollTo(y: number) { scrollCalls.push(`to:${y}`); fakeScrollTop = Math.max(0, Math.floor(y)) },
+  scrollBy(dy: number) { scrollCalls.push(`by:${dy}`) },
+  scrollToElement() {},
+  scrollToBottom() { scrollCalls.push('bottom') },
